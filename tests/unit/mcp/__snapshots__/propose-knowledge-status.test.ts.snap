                    "maxLength": 500,
                    "type": "string",
                  },
                  "transitionStatus": {
                    "enum": [
                      "WITH_CLIENT",
                      "IN_HANDOVER",
                      "WITH_ANKORA",
                      "NOT_PLANNED",
                    ],
                    "type": "string",
                  },
                  "triggerKinds": {
                    "items": {
                      "enum": [
                        "SCHEDULED",
                        "EVENT",
                        "ON_DEMAND",
                        "CONTINUOUS",
                      ],
                      "type": "string",
                    },
                    "maxItems": 4,
                    "type": "array",
                  },
                  "triggerText": {
                    "maxLength": 500,
                    "type": "string",
                  },
                },
                "title": "PROCESS",
                "type": "object",
              },
              {
                "description": "When target is DOMAIN. An email domain of the client (CLIENT) or of a supplier (PARTNER, with organizationName). No status. On CREATE it needs domain, kind; on SUPERSEDE or CONTRADICT, only the fields that change.",
                "properties": {
                  "domain": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string",
                  },
                  "kind": {
                    "enum": [
                      "CLIENT",
                      "PARTNER",
                    ],
                    "type": "string",
                  },
                  "organizationName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                },
                "title": "DOMAIN",
                "type": "object",
              },
              {
                "description": "When target is TASK. Something someone has to DO (a document to send, a call to set up), as an action, never a fact or a question. Without dueDate it is due in 3 business days. Read by everyone on the client: nothing sensitive. Never enters the file. No status, ownerName or clientVisible. On CREATE it needs title; on SUPERSEDE or CONTRADICT, only the fields that change.",
                "properties": {
                  "assigneeName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "description": {
                    "maxLength": 4000,
                    "type": "string",
                  },
                  "dueDate": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string",
                  },
                  "priority": {
                    "enum": [
                      "LOW",
                      "NORMAL",
                      "HIGH",
                      "URGENT",
                    ],
                    "type": "string",
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "title": "TASK",
                "type": "object",
              },
              {
                "description": "When target is DATE. A date of the client's own (payday, deadline, departure). date for ONCE and ANNUAL, dayOfMonth for MONTHLY (intervalMonths 2, 3, 4 or 6), weekday for WEEKLY (0 Sunday). Recurring work is a PROCESS with its DATE. One on the same day as a date in the file, under almost the same title, comes back in possibleMatches: if it is the same, leave it out. No status. On CREATE it needs title, recurrence; on SUPERSEDE or CONTRADICT, only the fields that change.",
                "properties": {
                  "businessCalendar": {
                    "enum": [
                      "IL",
                      "US",
                    ],
                    "type": "string",
                  },
                  "category": {
                    "enum": [
                      "PEOPLE_FAMILY",
                      "DOCUMENTS_AUTHORITIES",
                      "BUSINESS_FINANCE",
                      "VEHICLE_PROPERTY",
                      "HEALTH_TRAVEL",
                      "GENERAL",
                    ],
                    "type": "string",
                  },
                  "clientVisible": {
                    "type": [
                      "boolean",
                      "null",
                    ],
                  },
                  "conditionText": {
                    "maxLength": 300,
                    "type": "string",
                  },
                  "date": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string",
                  },
                  "dayAlternatives": {
                    "items": {
                      "maximum": 31,
                      "minimum": 1,
                      "type": "integer",
                    },
                    "maxItems": 5,
                    "type": "array",
                  },
                  "dayOfMonth": {
                    "maximum": 31,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "expectedFrom": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "expectsReceipt": {
                    "type": [
                      "boolean",
                      "null",
                    ],
                  },
                  "ifNotBusinessDay": {
                    "enum": [
                      "BEFORE",
                      "AFTER",
                    ],
                    "type": "string",
                  },
                  "intervalMonths": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer",
                  },
                  "notes": {
                    "maxLength": 1000,
                    "type": "string",
                  },
                  "processName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "recurrence": {
                    "enum": [
                      "ONCE",
                      "ANNUAL",
                      "MONTHLY",
                      "WEEKLY",
                    ],
                    "type": "string",
                  },
                  "responsibleName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "sensitivity": {
                    "enum": [
                      "NORMAL",
                      "SENSITIVE",
                    ],
                    "type": "string",
                  },
                  "taskDaysBefore": {
                    "maximum": 60,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                  "weekday": {
                    "maximum": 6,
                    "minimum": 0,
                    "type": "integer",
                  },
                },
                "title": "DATE",
                "type": "object",
              },
            ],
            "description": "This item's fields, by its target: use the variant whose title is the item's target.",
          },
          "quote": {
            "type": "string",
          },
          "reason": {
            "type": "string",
          },
          "status": {
            "description": "CONFIRMED: the client or their supplier said or showed it explicitly. UNCERTAIN: said, but not clearly or not by them (add payload.toResolve). MISSING: needed and not known (add payload.toResolve). Left out: HIGH confidence is CONFIRMED, anything else UNCERTAIN. Not for NARRATIVE, DOMAIN, TASK, DATE or a QUESTION fact.",
            "enum": [
              "CONFIRMED",
              "UNCERTAIN",
              "MISSING",
            ],
            "type": "string",
          },
          "target": {
            "enum": [
              "FACT",
              "CONTACT",
              "ORGANIZATION",
              "SYSTEM",
              "REQUEST_TYPE",
              "POLICY",
              "ENTITY",
              "NARRATIVE",
              "PROCESS",
              "DOMAIN",
              "TASK",
              "DATE",
            ],
            "type": "string",
          },
          "targetId": {
            "type": "string",
          },
        },
        "required": [
          "target",
          "payload",
        ],
        "type": "object",
      },
      "maxItems": 60,
      "minItems": 1,
      "type": "array",
    },
    "newSource": {
      "properties": {
        "clientConversation": {
          "description": "For kind ANKORA_DOCUMENT only: true when the document writes down what the client said in a conversation with them (an intake summary typed during the meeting). Its items are then not lowered to uncertain just because Ankora wrote them.",
          "type": "boolean",
        },
        "date": {
          "description": "YYYY-MM-DD",
          "type": "string",
        },
        "documentId": {
          "description": "For a document in the client's file (list_documents).",
          "type": "string",
        },
        "firefliesId": {
          "type": "string",
        },
        "gmailThreadId": {
          "description": "For kind EMAIL: the Gmail thread id, so the same thread is one source.",
          "type": "string",
        },
        "kind": {
          "enum": [
            "TRANSCRIPT",
            "CLIENT_DOCUMENT",
            "TASK",
            "PERSON",
            "ANKORA_DOCUMENT",
            "EMAIL",
          ],
          "type": "string",
        },
        "participants": {
          "items": {
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "taskId": {
          "description": "For kind TASK: the task the knowledge came out of, such as a mapping task.",
          "type": "string",
        },
        "title": {
          "type": "string",
        },
        "topicsOnly": {
          "description": "True for a restricted meeting: topics only, no quotes.",
          "type": "boolean",
        },
      },
      "required": [
        "kind",
        "title",
      ],
      "type": "object",
    },
    "note": {
      "description": "One line: what was read, what was left out.",
      "type": "string",
    },
    "sourceCode": {
      "description": "An existing source code in the client's register, e.g. S3.",
      "type": "string",
    },
    "uncertain": {
      "description": "Only when it is not clear whose meeting this is. Needs newSource of kind TRANSCRIPT.",
      "properties": {
        "candidates": {
          "description": "Every client the meeting could belong to, by name, including \`client\`.",
          "items": {
            "type": "string",
          },
          "maxItems": 6,
          "minItems": 2,
          "type": "array",
        },
        "reason": {
          "description": "Why \`client\` is the likely one: what in the title or the content points to it.",
          "type": "string",
        },
      },
      "required": [
        "candidates",
        "reason",
      ],
      "type": "object",
    },
  },
  "required": [
    "client",
    "items",
  ],
  "type": "object",
}
`;
