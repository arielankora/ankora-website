                "description": "When target is NARRATIVE. One of the file's free texts. body is the WHOLE new text and replaces the current one; cite sources inside it as [S1 08:13]. No status. On CREATE it needs kind, body; on SUPERSEDE or CONTRADICT, only the fields that change.",
                "properties": {
                  "body": {
                    "maxLength": 20000,
                    "minLength": 1,
                    "type": "string",
                  },
                  "kind": {
                    "enum": [
                      "OVERVIEW",
                      "BACKGROUND",
                      "OUR_ROLE",
                    ],
                    "type": "string",
                  },
                },
                "title": "NARRATIVE",
                "type": "object",
              },
              {
                "description": "When target is PROCESS. Something that recurs (a one-time project is a TASK). Enters as a draft; a manager approves the procedure. notApplicableFields only when it is clear a documentation field does not apply. steps when the procedure was described. On CREATE it needs title; on SUPERSEDE or CONTRADICT, only the fields that change.",
                "properties": {
                  "approvalPolicyTitles": {
                    "items": {
                      "maxLength": 200,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "type": "array",
                  },
                  "approvalText": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "approverName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "approverText": {
                    "maxLength": 300,
                    "type": "string",
                  },
                  "clientVisible": {
                    "type": "boolean",
                  },
                  "doNotDisclose": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "entityName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "exceptionPlaybook": {
                    "maxLength": 4000,
                    "type": "string",
                  },
                  "executorText": {
                    "maxLength": 300,
                    "type": "string",
                  },
                  "externalPartyNames": {
                    "items": {
                      "maxLength": 200,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "type": "array",
                  },
                  "externalPartyText": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "externalRefs": {
                    "items": {
                      "anyOf": [
                        {
                          "maxLength": 120,
                          "type": "string",
                        },
                        {
                          "properties": {
                            "id": {
                              "maxLength": 120,
                              "type": "string",
                            },
                            "system": {
                              "maxLength": 60,
                              "type": "string",
                            },
                          },
                          "required": [
                            "system",
                            "id",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    "maxItems": 20,
                    "type": "array",
                  },
                  "highlights": {
                    "maxLength": 4000,
                    "type": "string",
                  },
                  "importance": {
                    "enum": [
                      "NORMAL",
                      "LOW",
                    ],
                    "type": "string",
                  },
                  "notApplicableFields": {
                    "items": {
                      "enum": [
                        "sla",
                        "systems",
                        "approvals",
                        "external",
                        "exceptions",
                      ],
                      "type": "string",
                    },
                    "maxItems": 5,
                    "type": "array",
                  },
                  "outputs": {
                    "maxLength": 2000,
                    "type": "string",
                  },
                  "ownerName": {
                    "maxLength": 200,
                    "type": "string",
                  },
                  "purpose": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "sensitivity": {
                    "enum": [
                      "NORMAL",
                      "SENSITIVE",
                    ],
                    "type": "string",
                  },
                  "slaText": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "steps": {
                    "items": {
                      "properties": {
                        "actionTags": {
                          "items": {
                            "enum": [
                              "PAYMENT",
                              "PURCHASE",
                              "INVOICE",
                              "SUPPLIER_NEW",
                              "CONTRACT",
                              "PRICE_CHANGE",
                              "REFUND",
                              "CLIENT_MESSAGE",
                              "CREDENTIAL_ACCESS",
                              "DATA_EXPORT",
                              "HR",
                              "LEGAL",
                              "BANK_SIGNATURE",
                            ],
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "mode": {
                          "enum": [
                            "MANUAL",
                            "ASSISTED",
                            "AUTOMATED",
                          ],
                          "type": "string",
                        },
                        "offsetBusinessDays": {
                          "maximum": 60,
                          "minimum": -60,
                          "type": "integer",
                        },
                        "output": {
                          "maxLength": 500,
                          "type": "string",
                        },
                        "requiresApproval": {
                          "type": "boolean",
                        },
                        "systemNames": {
                          "items": {
                            "maxLength": 200,
                            "type": "string",
                          },
                          "maxItems": 10,
                          "type": "array",
                        },
                        "title": {
                          "maxLength": 300,
                          "minLength": 1,
                          "type": "string",
                        },
                        "verification": {
                          "maxLength": 500,
                          "type": "string",
                        },
                      },
                      "required": [
                        "title",
                      ],
                      "type": "object",
                    },
                    "maxItems": 15,
                    "type": "array",
                  },
                  "systemNames": {
                    "items": {
                      "maxLength": 200,
                      "type": "string",
                    },
                    "maxItems": 20,
                    "type": "array",
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
