{
  "manifest_version": 3,
  "name": "Ankora: Claude usage limits",
  "short_name": "Ankora limits",
  "version": "1.0.0",
  "description": "Sends Ankora the share of your Claude usage limits already used (five-hour and weekly). Nothing else: no conversations, no content.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "identity", "identity.email", "cookies"],
  "host_permissions": ["https://claude.ai/*", "https://www.ankora.co.il/*"],
  "storage": { "managed_schema": "managed_schema.json" },
  "options_page": "options.html"
}
