{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/he", "permanent": true }
  ],
  "crons": [
    { "path": "/api/cron/alerts-reconcile", "schedule": "0 5 * * *" },
    { "path": "/api/cron/scheduled-reports", "schedule": "0 0 * * *" },
    { "path": "/api/cron/vault-rewrap", "schedule": "30 1 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "qa/*": false,
      "qa/**": false,
      "docs/*": false,
      "docs/**": false,
      "chore/*": false,
      "chore/**": false,
      "claude/*": false,
      "claude/**": false,
      "test/*": false,
      "test/**": false
    }
  }
}
