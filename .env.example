# Copy to .env.local for local development. Never commit real secrets -
# this file only documents which variables exist and what they're for.

# ---------------------------------------------------------------------
# Blog admin (/he/admin, /en/admin) - existing feature
# ---------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Do NOT set GITHUB_BRANCH as a fixed value in Vercel's dashboard - it
# overrides the per-deployment branch fallback in lib/github.ts and was
# the root cause of a bug where every Preview deployment published posts
# to one fixed branch instead of its own. Leave unset; the code falls
# back to Vercel's own VERCEL_GIT_COMMIT_REF (auto-injected, no action
# needed) or "main".

# ---------------------------------------------------------------------
# Time Tracking app (/app) - Phase 0/1
# ---------------------------------------------------------------------
# Postgres connection string. Local dev: run `npm run db:dev` (embedded
# Postgres on port 55432) and use the value below as-is. Preview/
# Production: the connection string Vercel's Postgres integration injects
# automatically once the database is provisioned and linked to this
# project - you do not need to copy/paste it by hand in that case.
DATABASE_URL="postgresql://ankora:ankora_dev_only@127.0.0.1:55432/ankora_dev"

# Auth.js v5 session/JWT signing secret. Generate one with:
#   openssl rand -base64 32
# Required in every environment (local/preview/production) and must be
# set directly in Vercel's dashboard for Preview + Production - it is not
# provided automatically the way DATABASE_URL is.
AUTH_SECRET=
