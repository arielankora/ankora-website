// Ankora Time Tracking - Phase 0/1 schema.
//
// Scope discipline: this file models ONLY what Phase 0 (schema/environments)
// and Phase 1 (auth, roles, users, clients, categories) require, per
// docs/adr/0001-time-tracking-app-architecture.md and spec section 23.
// Task/TimeEntry/HourBank/AlertRule/BillingPolicy/ReportSchedule/
// EmailDelivery/IntegrationConnection etc. belong to later phases and are
// deliberately NOT modeled yet - adding them now would be scope creep the
// spec's own "לא להמציא" instruction warns against.
//
// Conventions (spec section 0 / 25, non-negotiable defaults):
// - All timestamps stored in UTC (Prisma DateTime -> Postgres timestamptz).
// - Durations/money are never floats - not applicable yet in Phase 1 (no
//   TimeEntry/billing amounts here), but the convention is documented for
//   Phase 2+.
// - Soft delete only (deletedAt), never hard delete via the app.
// - Every credential-adjacent/administrative change must be auditable
//   (AuditEvent) - enforced in application code, not the DB, but the table
//   exists from Phase 1 onward so nothing is retrofitted later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------

/// Internal Ankora staff roles, per spec section 4. Client-side portal
/// users are represented by CLIENT_USER + a per-client ClientUserRole
/// (see ClientUser below) rather than a fixed global role, since a client
/// user's authority is scoped to their own client, not global.
enum UserRole {
  SUPER_ADMIN
  ANKORA_ADMIN
  ANKORA_EMPLOYEE
  CLIENT_USER
}

/// Spec section 4.2 - explicit list.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Not explicitly enumerated in the spec beyond "status" - reasonable
/// default per section 25's "use a sensible default, but keep it
/// configurable" instruction. Documented in ADR-0001.
enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Client Admin vs Client Viewer, spec section 4 role table.
enum ClientUserRole {
  ADMIN
  VIEWER
}

/// Category.visibility, spec section 10.1.
enum CategoryVisibility {
  GLOBAL
  CLIENT
}

/// Task.status, spec section 5's data model + section 10.2: "סטטוסים: Open /
/// In progress / Done / Archived." Added in the Phase 9 gap-fix pass (spec
/// re-audit, docs/adr/0001 section 17.2) - the Task model existed since
/// Phase 2 but never had a status column, so every task was implicitly
/// "open" forever with no way to express otherwise.
enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

// --- Core models ---------------------------------------------------------

/// Every human who can log in - internal Ankora staff AND client-portal
/// users share this table (spec section 5 lists a single User entity).
/// What a given user can see/do is determined by `role` for internal
/// staff, and by their ClientUser row(s) for client-side users.
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  username     String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(INVITED)
  timezone     String     @default("Asia/Jerusalem")

  /// App redesign, Profile screen (screen 18, docs/adr/0001 section 23):
  /// the one real per-user notification preference backing that screen's
  /// "התראות אישיות" toggle. Gates only the *email* half of
  /// notifyLongRunningTimers() (lib/app-domain/notifications.ts) - the
  /// persisted in-app Notification row (feeding /app/notifications and the
  /// header bell) is still created unconditionally either way. Default
  /// true preserves today's behavior for every existing row.
  notifyLongRunningTimerByEmail Boolean @default(true)

  /// Incremented to invalidate every previously-issued session JWT at once
  /// (spec 4.2: "logout all sessions" for admins) without needing a
  /// database-backed session table for a Credentials-only auth flow.
  tokenVersion Int @default(0)

  /// Spec 4.2: "Rate limiting ו-lockout הדרגתי לניסיונות כושלים." A simple
  /// persisted counter + lockout window - correct for MVP scale, and
  /// persisted (rather than in-memory) because serverless functions don't
  /// share memory between invocations.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clientMemberships   ClientUser[]
  clientAccess        UserClientAccess[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
  timeEntries         TimeEntry[]
  timeEntryRevisions  TimeEntryRevision[]  @relation("TimeEntryRevisionActor")
  hourBankAdjustments HourBankAdjustment[] @relation("HourBankAdjustmentCreator")
  notifications       Notification[]

  // Phase 10: Important Dates (מועדים חשובים).
  assignedTasks              Task[]                        @relation("TaskAssignee")
  importantDatesResponsible  ImportantDate[]                @relation("ImportantDateResponsible")
  importantDatesCreated      ImportantDate[]                @relation("ImportantDateCreator")
  holidaySubscriptionsOwned  HolidayCalendarSubscription[]  @relation("HolidaySubscriptionResponsible")

  // Phase 13: MCP server (docs/adr/0005).
  mcpAccessTokens McpAccessToken[]

  @@index([role, status])
  @@map("users")
}

/// Spec 4.2: "Forgot password באמצעות link חד-פעמי עם expiry." Only the
/// SHA-256 hash of the token is stored - the raw token exists only in the
/// emailed link, same principle as never storing plaintext passwords.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Phase 13 (docs/adr/0005): a personal access token that lets ONE Ankora
/// employee reach the MCP server at /api/mcp from their own Claude
/// Desktop. Deliberately per-user and never per-organization: every tool
/// call resolves this row to a real `User` and runs through the same
/// `assertCan`/`listAccessibleClients` checks a screen does, so a shared
/// credential would erase the entire RBAC model (lib/app-auth/
/// permissions.ts) and leave every AuditEvent pointing at the same actor.
///
/// Only the SHA-256 hash is stored, exactly like PasswordResetToken above
/// and for the identical reason. Note this is a *different* pattern from
/// lib/cron-auth.ts's constant-time compare, on purpose: that endpoint
/// compares one presented string against one known secret, which needs
/// timingSafeEqual; here the presented token is hashed first and used as
/// an indexed lookup key, so a wrong token simply finds no row and there
/// is no per-byte comparison to time.
///
/// `expiresAt` is mandatory (no never-expiring tokens). Revocation has two
/// independent paths: `revokedAt` on this row, and User.tokenVersion - see
/// lib/mcp/auth.ts for why the second one matters.
model McpAccessToken {
  id         String    @id @default(cuid())
  userId     String
  /// Human-readable label so a user can tell two of their own tokens apart
  /// when revoking one ("MacBook Air", "old laptop").
  label      String
  tokenHash  String    @unique
  /// Snapshot of User.tokenVersion when the token was issued. A later
  /// "logout all sessions" bumps the user's counter past this value and
  /// the token stops resolving - see lib/mcp/auth.ts.
  tokenVersion Int     @default(0)
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("mcp_access_tokens")
}

/// A customer of Ankora. Billing policy / hour bank fields are
/// deliberately NOT modeled here yet (Phase 3) - only what Phase 1's
/// "clients" epic needs: identity, status, contact/timezone, and the
/// relations that make RBAC and categories work.
model Client {
  id             String       @id @default(cuid())
  name           String
  legalName      String?
  status         ClientStatus @default(ACTIVE)
  timezone       String       @default("Asia/Jerusalem")
  primaryContact String?

  /// Phase 6 (spec 13/14.1: "employee name configurable"). Whether the
  /// Client Portal's Weekly Activity / Monthly Detailed reports show which
  /// Ankora employee performed each entry, or omit that column entirely.
  /// Spec section 25 gives no explicit default for this specific toggle,
  /// so it defaults to true (maximum transparency, matching the spec's
  /// stated purpose for the whole portal - section 13: "לתת ללקוחות
  /// שקיפות מבוקרת") - Ankora can flip it per client if a contract
  /// requires anonymity. Documented in docs/adr/0001's Phase 6 addendum.
  portalShowEmployeeNames Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portalUsers  ClientUser[]
  employeeAccess UserClientAccess[]
  categories   Category[]
  auditEvents  AuditEvent[] @relation("AuditClient")
  tasks        Task[]
  timeEntries  TimeEntry[]
  billingPolicy       BillingPolicy?
  hourBanks           HourBank[]
  hourBankAdjustments HourBankAdjustment[]
  alertRules          AlertRule[]
  reportSchedules     ReportSchedule[]

  // Phase 10: Important Dates (מועדים חשובים).
  importantDates       ImportantDate[]
  holidaySubscriptions HolidayCalendarSubscription[]

  @@index([status])
  @@map("clients")
}

/// Links a User (role=CLIENT_USER) to the Client they belong to, with
/// their client-scoped role. Spec section 5: ClientUser(client_id,
/// user_id, client_role).
model ClientUser {
  id       String         @id @default(cuid())
  clientId String
  userId   String
  role     ClientUserRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_users")
}

/// Which clients an Ankora employee is allowed to report time against /
/// view. Spec 4.1: "לכל עובד ניתן להגדיר רשימת לקוחות מורשים." Kept as a
/// plain assignment table in Phase 1 - granular per-assignment
/// permissions (e.g. edit-others override) are a Phase 2+ concern once
/// TimeEntry exists to actually scope.
model UserClientAccess {
  id       String @id @default(cuid())
  userId   String
  clientId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_access")
}

/// Global or client-specific work categories. Spec section 10.1.
model Category {
  id          String             @id @default(cuid())
  name        String
  description String?
  active      Boolean            @default(true)
  visibility  CategoryVisibility @default(GLOBAL)
  /// Required when visibility = CLIENT, null when GLOBAL.
  clientId    String?
  sortOrder   Int                @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeEntries TimeEntry[]
  // Phase 10: Important Dates (מועדים חשובים) - category an auto-created
  // task should use when ImportantDate.createAutoTask = true.
  importantDatesAutoTaskCategory ImportantDate[]

  @@index([visibility, clientId, active])
  @@map("categories")
}

/// Append-only audit trail. Spec section 16.1 lists the Phase-1-relevant
/// event types this must cover from day one: login success/failure,
/// user role/access change, client settings change. Never updated or
/// deleted from the application - read-only in the Admin UI (section 12).
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  clientId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  client Client? @relation("AuditClient", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Phase 2: Timer + TimeEntry + manual entry + audit revisions ---------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 2"):
// only Task/TimeEntry/TimeEntryRevision are modeled here. HourBank,
// AlertRule, BillingPolicy, ReportSchedule, EmailDelivery,
// IntegrationConnection remain out of scope until Phase 3+ - adding them
// now would be the same scope creep Phase 1's header comment warned
// against. billableSeconds defaults to actualSeconds (no BillingPolicy
// exists yet to diverge them); the column exists now per spec section 5
// so Phase 3 doesn't need a backfill migration.
//
// IMPORTANT - constraint that lives ONLY in the hand-authored migration
// SQL, not expressible in this file: spec 18.2 requires "concurrent start
// requests create max one active timer." Prisma's schema DSL has no
// portable way to declare a partial unique index (unique per user only
// among rows where endAt IS NULL), so the actual enforcement is a
// Postgres partial unique index created directly in
// prisma/migrations/.../migration.sql:
//   CREATE UNIQUE INDEX time_entries_one_active_per_user
//     ON time_entries (user_id) WHERE end_at IS NULL;
// Application code in lib/app-domain/time-entries.ts additionally
// pre-checks for a friendlier error message, but the database constraint
// is the actual race-safe guarantee - the pre-check alone is not enough
// under concurrent requests. If this file and the migration ever appear
// to drift on this specific index, the migration is the source of truth;
// do not let a Prisma-generated migration silently drop it.

/// Phase 14 (MCP server writes, docs/adr/0005): WHERE an entry was created
/// from, which is a different question from TimeEntrySource's HOW (a timer
/// vs a typed form). Both matter: "Claude started a timer" is TIMER+MCP,
/// "Ariel typed one in" is MANUAL+APP.
///
/// Without this column there is no way to tell an entry a person typed
/// from one an agent created, and the first bad write would be
/// untraceable - AuditEvent records who acted, not through what. Defaults
/// to APP so every existing row is correctly labelled by the migration.
enum EntryOrigin {
  APP
  MCP
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

/// Free-text-first per spec 6.1 ("Task יכולה להיות free-text ב-MVP אך
/// נשמרת כישות אם המשתמש בוחר 'צור משימה'"). Phase 2 only needs enough of
/// this entity for TimeEntry.taskId to point somewhere and for the
/// ClickUp-shaped source/externalRef columns to already exist (spec 10) -
/// a full Tasks management screen is not part of Phase 2's stated scope
/// ("Timer + TimeEntry + manual entry + audit revisions") and is deferred.
model Task {
  id          String    @id @default(cuid())
  clientId    String
  categoryId  String?
  title       String
  status      TaskStatus @default(OPEN)
  source      String    @default("local")
  externalRef String?

  // Phase 10 (Important Dates, "מועדים חשובים"): the spec asks to extend
  // Task with assignee + due date + a link back to the ImportantDate/
  // occurrence that auto-created it, "אם השדות עדיין אינם קיימים" - none
  // of these four existed before this phase. assignedToId/dueDate are
  // useful for ANY task (not only auto-created ones), so they're plain
  // optional columns, not important-dates-specific. importantDateId +
  // importantDateOccurrenceKey exist ONLY on auto-created rows and are
  // the "one task per (date, occurrence-year)" dedupe guard (spec: "אם
  // קיימת משימה פתוחה הקשורה לאותו מועד ומופע, אין ליצור נוספת") - a
  // unique constraint on the pair is the actual safety net (Postgres
  // treats these as distinct when both are NULL, i.e. ordinary
  // manually-created tasks never collide with each other here), mirroring
  // ReminderOccurrence.idempotencyKey's precedent below.
  assignedToId               String?
  dueDate                    DateTime?
  importantDateId            String?
  importantDateOccurrenceKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  importantDate ImportantDate? @relation(fields: [importantDateId], references: [id], onDelete: SetNull)
  timeEntries   TimeEntry[]

  @@unique([importantDateId, importantDateOccurrenceKey])
  @@index([clientId])
  @@index([assignedToId])
  @@map("tasks")
}

/// Spec section 5 + 6. A row with endAt = null is a currently-running
/// timer (source=TIMER). Manual entries (source=MANUAL) always have both
/// startAt and endAt set at creation. actualSeconds/billableSeconds are
/// null while a timer is running and computed on stop.
model TimeEntry {
  id     String @id @default(cuid())
  userId String

  clientId   String
  categoryId String
  taskId     String?

  startAt DateTime
  endAt   DateTime?

  /// Server-computed only (spec 18.1: "server end time + compute actual"),
  /// never trusted from the client. Null while a timer is actively running.
  actualSeconds Int?
  /// Defaults to actualSeconds once BillingPolicy exists in Phase 3 to
  /// diverge them (spec section 7).
  billableSeconds Int?

  note String?

  source   TimeEntrySource @default(MANUAL)
  isManual Boolean         @default(false)
  /// True once any post-creation edit has produced a TimeEntryRevision.
  /// Spec 6.4: "כל עריכה ידנית מסומנת באייקון פנימי 'Edited'."
  isEdited Boolean         @default(false)

  /// Phase 14: APP for anything created through the web app, MCP for
  /// anything created through /api/mcp. See the EntryOrigin enum above.
  createdVia EntryOrigin @default(APP)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete only, per spec 6.1's "Audit שאסור לוותר עליו" box and the
  /// schema-header convention - never a hard DELETE via the app.
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  revisions TimeEntryRevision[]

  @@index([userId, startAt])
  @@index([clientId, startAt])
  @@index([categoryId, startAt])
  @@map("time_entries")
}

/// Immutable audit trail for every TimeEntry mutation after creation.
/// Spec 6.1's "Audit שאסור לוותר עליו" box: must snapshot before/after,
/// who, when, and (for admin-on-behalf-of-another-user edits) why. Never
/// updated or deleted - version is a simple 1,2,3... counter per entry.
model TimeEntryRevision {
  id          String   @id @default(cuid())
  timeEntryId String
  version     Int
  changedById String?
  changedAt   DateTime @default(now())
  beforeJson  Json?
  afterJson   Json?
  reason      String?

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("TimeEntryRevisionActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([timeEntryId, version])
  @@map("time_entry_revisions")
}

// --- Phase 3: Billing policy + hour bank + live client snapshot ----------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 3"):
// only BillingPolicy, HourBank, HourBankAdjustment are modeled here.
// AlertRule/AlertEvent (Phase 4), ReportSchedule/EmailDelivery (Phase 5/6),
// IntegrationConnection/ExternalMapping (Phase 8) remain out of scope.
//
// billableSeconds on TimeEntry (added in Phase 2) is now actually allowed
// to diverge from actualSeconds via BillingPolicy (spec section 7). A
// client with NO BillingPolicy row keeps the exact Phase 2 behavior
// (billable = actual, unmodified) - backward compatibility per the
// engagement's own standing instruction. See lib/app-domain/billing.ts.

/// Spec 7.1's own example table, used verbatim.
enum RoundingMode {
  CEIL
  NEAREST
  EXACT
}

/// Spec 7.1: "Aggregation scope: per entry / per task per day / per day."
enum BillingAggregationScope {
  PER_ENTRY
  PER_TASK_PER_DAY
  PER_DAY
}

/// Spec 8.2: "Rollover configurable: none / full / capped / manual."
enum RolloverMode {
  NONE
  FULL
  CAPPED
  MANUAL
}

/// Spec 8.2: a cycle is normally OPEN (current), becomes CLOSED once
/// cycle_end passes, and flips to RECALCULATED if a backdated edit lands
/// inside an already-CLOSED cycle's date range ("המערכת מחשבת מחדש
/// ומסמנת את ה-cycle כ-recalculated; אין לשנות silently דוח שכבר הופק
/// ללא log").
enum HourBankStatus {
  OPEN
  CLOSED
  RECALCULATED
}

/// Spec section 5's field list, verbatim: client_id, minimum_minutes,
/// increment_minutes, rounding_mode, applies_per_entry/per-task/per-day.
/// One row per client (spec 7.1: "Client override: כן"); a client with no
/// row here uses the neutral, no-op default (minimum 0, increment 1
/// minute, rounding EXACT, per-entry) - i.e. billable stays identical to
/// actual, exactly like every Phase 2 entry today. Spec 7.1's own
/// "Employee override: לא, אלא Permission מיוחד" is intentionally NOT
/// modeled as a separate per-user override table in Phase 3 - no such
/// special permission exists yet, and adding the structure for a
/// not-yet-real permission would be the same speculative scope creep the
/// spec's own "לא להמציא" instruction (section 25) warns against.
model BillingPolicy {
  id               String                  @id @default(cuid())
  clientId         String                  @unique
  minimumMinutes   Int                     @default(0)
  incrementMinutes Int                     @default(1)
  roundingMode     RoundingMode            @default(EXACT)
  aggregationScope BillingAggregationScope @default(PER_ENTRY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("billing_policies")
}

/// Spec section 5 + 8.2. One row per client per cycle (monthly by
/// default per section 25, but cycle_start/cycle_end are explicit dates
/// so an irregular first/last cycle is representable). consumedMinutes is
/// a cached snapshot of live usage (spec 8.3's formula, recomputed by
/// lib/app-domain/hour-banks.ts on every read of "current" - never trusted
/// stale for the live view) so historical cycles retain a sensible value
/// once closed without re-scanning TimeEntry forever.
///
/// rolloverMode/rolloverCapMinutes are NOT in spec section 5's bare field
/// list, but section 8.2 requires "Rollover configurable: none / full /
/// capped / manual" per client/cycle and section 25 confirms "Rollover:
/// Configurable; enabled per client if contract says so" without
/// specifying where the mode itself lives. Storing it on the cycle that
/// PRODUCES the rollover (rather than inventing a separate
/// ClientBillingSettings entity the spec never mentions) is the smallest
/// addition that satisfies the requirement - documented here and in
/// docs/adr/0001's Phase 3 addendum as an explicit, deliberate choice for
/// an underspecified parameter, per this engagement's standing
/// "document decisions" instruction.
model HourBank {
  id       String @id @default(cuid())
  clientId String

  cycleStart DateTime
  cycleEnd   DateTime

  purchasedMinutes   Int
  rolloverInMinutes  Int @default(0)
  rolloverMode       RolloverMode @default(NONE)
  /// Only meaningful when rolloverMode = CAPPED.
  rolloverCapMinutes Int?

  /// Cached snapshot - spec 8.3's live formula, recomputed on read.
  consumedMinutes Int @default(0)

  status         HourBankStatus @default(OPEN)
  recalculatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adjustments HourBankAdjustment[]

  @@unique([clientId, cycleStart])
  @@index([clientId, cycleStart])
  @@map("hour_banks")
}

/// Spec section 5's field list, verbatim: client_id, minutes +/-, reason,
/// created_by, effective_at. hourBankId is an additional, optional
/// convenience FK (not in the spec's bare list) so the admin UI can
/// attach an adjustment to a specific cycle explicitly rather than only
/// inferring cycle membership from effective_at at read time - documented
/// here as a deliberate, minimal addition, same rationale as HourBank's
/// rollover fields above.
model HourBankAdjustment {
  id          String   @id @default(cuid())
  clientId    String
  hourBankId  String?
  /// Positive = credit added, negative = deduction. Spec 8.2: "manual
  /// adjustments."
  minutes     Int
  reason      String
  createdById String?
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hourBank  HourBank? @relation(fields: [hourBankId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("HourBankAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, effectiveAt])
  @@map("hour_bank_adjustments")
}

// --- Phase 4: Alerts + email delivery -------------------------------------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 4"):
// only AlertRule, AlertEvent, EmailDelivery are modeled here.
// ReportSchedule (Phase 5/6) and IntegrationConnection/ExternalMapping
// (Phase 8) remain out of scope.

/// Spec 9.1's threshold table. Forecast is explicitly marked "Future" in
/// the spec itself, so only the other four rows are modeled - not an
/// oversight, see ADR 11.3.
enum AlertThresholdType {
  UTILIZATION_PCT
  REMAINING_MINUTES
  CONSUMED_MINUTES
  OVERAGE
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

/// Spec section 5 + 9.1. One row per (client, threshold definition).
/// recipientsAnkora/recipientsClient are plain email-address arrays -
/// spec 9.1: "כל Rule כולל recipients נפרדים ל-Ankora וללקוח" - no
/// per-recipient entity is warranted for what is just a short address
/// list per rule (ADR 11.3).
model AlertRule {
  id       String             @id @default(cuid())
  clientId String
  type     AlertThresholdType

  /// Meaning depends on `type`: percentage points for UTILIZATION_PCT
  /// (e.g. 80 = 80%), minutes for REMAINING_MINUTES/CONSUMED_MINUTES,
  /// ignored (0) for OVERAGE - spec 9.1's own examples ("Remaining hours
  /// <= 5") are always expressed here as minutes, never float hours, per
  /// section 25's storage convention.
  thresholdValue Int @default(0)

  recipientsAnkora String[]
  recipientsClient String[]

  enabled Boolean @default(true)

  /// Spec 9.2's own field name, used verbatim: "אלא אם
  /// rule.allow_retrigger=true."
  allowRetrigger Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([clientId, enabled])
  @@map("alert_rules")
}

/// Spec section 5 + 9.2. One row per time a rule actually fires.
/// resolvedAt implements the crossing/dedupe logic documented in ADR
/// 11.3 - null means "still above threshold since it fired", set once
/// utilization drops back below the threshold.
model AlertEvent {
  id         String   @id @default(cuid())
  ruleId     String
  hourBankId String
  triggeredAt DateTime @default(now())
  /// The raw metric value (minutes or percentage points, matching the
  /// rule's own `type`) at the moment this event fired - spec 5's "value"
  /// field, verbatim.
  value      Int
  resolvedAt DateTime?

  rule           AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([ruleId, hourBankId])
  @@map("alert_events")
}

/// Spec section 5's field list, verbatim: template, recipients,
/// provider_message_id, status, attempts, error. One row per logical
/// send action (Ankora recipients / client recipients are two separate
/// rows when a rule has both) - see ADR 11.3.
model EmailDelivery {
  id               String              @id @default(cuid())
  alertEventId     String?
  /// Phase 6 addition: set when this send is a scheduled client/internal
  /// report (spec 15) rather than a Phase 4 alert. A row has exactly one
  /// of alertEventId/reportRunId set in practice - not enforced as a DB
  /// CHECK constraint (Prisma has no portable way to express XOR across
  /// nullable FKs), but every write path only ever sets one of the two.
  reportRunId      String?
  template         String
  recipients       String[]
  providerMessageId String?
  status           EmailDeliveryStatus
  attempts         Int                 @default(1)
  lastAttemptAt    DateTime            @default(now())
  error            String?
  createdAt        DateTime            @default(now())

  alertEvent AlertEvent? @relation(fields: [alertEventId], references: [id], onDelete: SetNull)
  reportRun  ReportRun?  @relation(fields: [reportRunId], references: [id], onDelete: SetNull)

  @@index([status, attempts])
  @@map("email_deliveries")
}
// --- Phase 6: Client portal + scheduled reports ---------------------------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 6"):
// ReportSchedule + ReportRun are modeled here, per spec section 5's own
// field list for ReportSchedule ("client_id, report_type, frequency,
// recipients, timezone, enabled") plus the scheduling fields (dayOfWeek/
// dayOfMonth/hour) spec 15 requires but doesn't name explicitly ("Weekly
// report: ברירת מחדל configurable... Monthly report: ...ביום מוגדר").
// ReportRun is the "Snapshot/Report run id" spec 15 explicitly calls for
// ("לפני שליחה ליצור Snapshot/Report run id כדי שיהיה ניתן לדעת בדיוק מה
// נשלח") - one row per period actually sent, with the exact rendered
// report frozen as JSON, and a unique (scheduleId, periodStart) constraint
// that makes re-running the cron for an already-sent period a no-op
// rather than a duplicate send (spec 18.2's idempotency principle, applied
// here to scheduled sends instead of timer start/stop).
//
// ClientReportType is deliberately a 4-way subset of spec 14.1's 5-report
// client table: Monthly Detailed, Weekly Activity, Hours by Category, and
// Hour Bank Status. "Trend" is spec 14.1's own row explicitly marked
// "אופציונלי MVP+" - same exclusion precedent as Phase 4's AlertRule
// leaving out the spec-marked-Future "Forecast" threshold type.

enum ReportFrequency {
  WEEKLY
  MONTHLY
}

enum ClientReportType {
  MONTHLY_DETAILED
  WEEKLY_ACTIVITY
  HOURS_BY_CATEGORY
  HOUR_BANK_STATUS
}

/// Spec section 5 + 15. One row per (client, report type, cadence) an
/// Ankora admin has configured to auto-send. dayOfWeek (0=Sunday..
/// 6=Saturday) is read only when frequency=WEEKLY; dayOfMonth (1-28,
/// capped below 29 so every month has that day - spec never asks for
/// "last day of month" semantics) only when frequency=MONTHLY. `hour` is
/// the local hour (0-23, in `timezone`) the cron treats as this
/// schedule's due time - see lib/app-domain/report-schedules.ts's
/// isScheduleDue for the actual due-calculation, kept as a pure,
/// independently unit-tested function.
model ReportSchedule {
  id       String           @id @default(cuid())
  clientId String
  reportType ClientReportType
  frequency  ReportFrequency

  recipients String[]
  timezone   String   @default("Asia/Jerusalem")

  dayOfWeek  Int? // 0-6, WEEKLY only
  dayOfMonth Int? // 1-28, MONTHLY only
  hour       Int  @default(7)

  enabled    Boolean   @default(true)
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runs   ReportRun[]

  @@index([clientId, enabled])
  @@map("report_schedules")
}

/// The "Snapshot/Report run id" spec 15 requires. snapshotJson freezes
/// the exact rendered report (same shape as the portal screen that
/// produced it) at send time, independent of whatever the underlying
/// TimeEntry/HourBank rows look like later - so "what did we actually
/// send on that date" is always answerable even after subsequent edits
/// or a RECALCULATED cycle (spec 8.2's own "אין לשנות silently דוח שכבר
/// הופק ללא log" principle, applied to scheduled reports too).
model ReportRun {
  id          String   @id @default(cuid())
  scheduleId  String
  periodStart DateTime
  periodEnd   DateTime
  snapshotJson Json
  createdAt   DateTime @default(now())

  schedule        ReportSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@unique([scheduleId, periodStart])
  @@map("report_runs")
}

// --- Phase 8: Integration foundation validation + production rollout ----
//
// Spec section 23 scopes Phase 8 to "Integration foundation validation +
// production rollout" - the Epic table (section 22) names it explicitly:
// "generic tables/interfaces + no ClickUp coupling in domain." These two
// models are exactly spec section 5's own field list for them - no more,
// since 17.3 is explicit that Ankora can already show a placeholder
// "Integrations" admin screen without requesting any OAuth scope until
// the actual ClickUp integration is built. Task.source/externalRef
// (Phase 2) already exist for the eventual per-entity mapping; these two
// tables are the system-level connection record and the generic mapping
// table spec 17.1/17.2 describe for whenever that build happens.

/// Spec section 5: "IntegrationConnection - provider, status,
/// credentials_ref, config." One row per external provider (e.g.
/// "clickup") - not per-client, since spec 17.2's per-client Workspace/
/// Space/Folder/List mapping is future config that would live inside
/// `config` (Json) once built, not a new column now. `credentialsRef` is
/// deliberately a String, never the credential itself: spec 17.2 "Credentials
/// נשמרים secret/encrypted store, לא בטבלת plain text" - this column only
/// ever holds an opaque pointer into that external store (e.g. a Vercel/host
/// secret name), and nothing in this phase writes a real value into it,
/// since no OAuth flow exists yet (spec 17.3).
model IntegrationConnection {
  id            String               @id @default(cuid())
  provider      String               @unique
  status        IntegrationStatus    @default(NOT_CONNECTED)
  credentialsRef String?
  config        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings ExternalMapping[]

  @@map("integration_connections")
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// Spec section 5: "ExternalMapping - provider, internal_entity_type/id,
/// external_entity_type/id, sync metadata." Generic on purpose (spec
/// 17.1's Integration interface is provider-agnostic) - a Task-to-ClickUp-
/// task mapping is the first expected use per 17.2, but the shape is not
/// hardcoded to Task so a future Client-to-Workspace or Category-to-Folder
/// mapping does not need a new table. `syncMetadata` (Json) is deliberately
/// unopinionated: spec 17.2 requires idempotent webhook handling via
/// external event ids and leaves the exact bookkeeping fields
/// unspecified, so this stays a free-form bag rather than named columns
/// that would need a migration for every new provider's quirks. Unique on
/// (provider, internalEntityType, internalEntityId) - a given internal
/// entity can only be mapped once per provider - spec 17.2's own rule
/// ("לא להשתמש בשם המשימה כמפתח סנכרון") implies the internal id, not any
/// mutable field, is the stable half of the mapping.
model ExternalMapping {
  id                 String   @id @default(cuid())
  provider           String
  internalEntityType String
  internalEntityId   String
  externalEntityType String
  externalEntityId   String
  syncMetadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection IntegrationConnection @relation(fields: [provider], references: [provider], onDelete: Cascade)

  @@unique([provider, internalEntityType, internalEntityId])
  @@index([provider, externalEntityType, externalEntityId])
  @@map("external_mappings")
}

// --- Phase 9: gap-fix pass (spec re-audit, docs/adr/0001 section 17) ---

/// Spec section 11's "Notifications" screen ("חריגות/טיימר ארוך/alerts
/// פנימיים") - never modeled before this phase. Purely user-scoped (no
/// client/role scoping needed): every user only ever sees their own rows.
/// `type` is a free string rather than an enum on purpose, mirroring
/// AuditEvent.action's own precedent (docs/adr/0001) - new notification
/// kinds can be added without a schema migration.
model Notification {
  id       String  @id @default(cuid())
  userId   String
  type     String
  title    String
  body     String
  entityType String?
  entityId   String?
  readAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dedupes the long-running-timer notification (spec 6.1) so the daily
  // cron (see app/api/cron/alerts-reconcile) never sends a second email
  // for the same still-running TimeEntry - one notification row per
  // (type, entityId) pair is the dedupe key, checked before insert rather
  // than enforced by a DB constraint, since entityId is nullable for
  // notification types that aren't tied to one entity.
  @@index([userId, readAt])
  @@index([type, entityId])
  @@map("notifications")
}

// --- Phase 10: Important Dates ("מועדים חשובים") -------------------------
//
// Scope discipline: models ImportantDate, ReminderRule, ReminderOccurrence,
// HolidayCalendarSubscription, per the "מועדים חשובים" spec (HE, Sept
// 2026) - lets Ankora track per-client important dates (birthdays,
// document expiries, renewals, holidays, etc.), the reminders that fire
// before them, and the auto-created follow-up tasks. Reuses existing
// infrastructure end to end: Client/User/Task/Category, Notification,
// lib/email.ts, AuditEvent, soft delete, the daily reconciliation cron
// (app/api/cron/alerts-reconcile), and RBAC.
//
// Naming/modeling decisions where the spec is silent, documented once
// here rather than repeated on every field:
//
// - ImportantDate.type and HolidayCalendarSubscription.calendarKey are
//   plain Strings, not Postgres enums - the exact same precedent as
//   Notification.type/AuditEvent.action (see those models' own comments
//   above): the spec's own type catalog is large and the spec explicitly
//   wants it extensible without a migration ("אפשר למנהל להוסיף כותרת
//   מותאמת גם כאשר נבחר סוג קיים"). The canonical catalogs (label,
//   category, default recurrence, default reminders, holiday
//   definitions) live in code - lib/app-domain/important-dates-catalog.ts
//   and important-dates-holidays.ts - not the database.
// - relatedEntityType/relatedEntityName/relationToClient are flat
//   Strings, not a new normalized entity table (family member / vehicle /
//   property registry). The spec's own field list for ImportantDate asks
//   for exactly these flat fields ("סוג הישות שאליה המועד קשור", "שם
//   האדם או הפריט") - not a registry - and the "לא לפתח עכשיו" list
//   explicitly excludes OCR/document extraction, so nothing yet would
//   populate a normalized table beyond what these three strings capture.
// - Optimistic concurrency reuses the exact pattern already established
//   in Phase 7 (docs/adr/0001 section 14.7: an `updatedAt`-compare +
//   ConflictError, not a version-int column) - spec explicitly says "לפי
//   הדפוס הקיים."
// - ReminderRule.sendInApp/sendEmail are plain booleans rather than a
//   channel array - spec 9.1's own "ערוץ: התראה פנימית ו/או מייל" is
//   inherently a two-way choice, matching the codebase's existing
//   preference for booleans over enums on binary settings (e.g.
//   AlertRule.allowRetrigger).
// - ReminderOccurrence.idempotencyKey (spec: "מפתח Idempotency ייחודי") is
//   built from importantDateId + occurrenceYear + reminderRuleId +
//   recipient + channel (lib/app-domain/important-dates-reminders.ts's
//   buildIdempotencyKey) and carries the actual DB-level uniqueness
//   guarantee - the daily job's own pre-check is a friendlier early exit,
//   the same two-layer pattern TimeEntry's one-active-timer partial index
//   already uses (see that model's own header comment above).
// - Task gained assignedToId/dueDate/importantDateId/
//   importantDateOccurrenceKey as additive nullable columns (see that
//   model's own updated comment above) rather than a parallel task-like
//   entity - spec 25's "לא לבנות ארכיטקטורה מקבילה אם ניתן להרחיב רכיב
//   קיים" applied directly.

enum ImportantDateCategory {
  PEOPLE_FAMILY
  DOCUMENTS_AUTHORITIES
  BUSINESS_FINANCE
  VEHICLE_PROPERTY
  HEALTH_TRAVEL
  GENERAL
}

enum CalendarType {
  GREGORIAN
  HEBREW
}

enum RecurrenceType {
  ONCE
  ANNUAL
  MONTHLY
  CUSTOM_INTERVAL
}

/// Spec's explicit status list, used verbatim: פעיל / דורש טיפול / בטיפול
/// / טופל למופע הנוכחי / הושהה / בארכיון.
enum ImportantDateStatus {
  ACTIVE
  NEEDS_ATTENTION
  IN_PROGRESS
  HANDLED_CURRENT
  PAUSED
  ARCHIVED
}

enum ImportantDateSensitivity {
  NORMAL
  SENSITIVE
}

/// Spec: "מקור המועד: ידני, חג או תבנית."
enum ImportantDateSource {
  MANUAL
  HOLIDAY
  TEMPLATE
}

enum ReminderChannel {
  IN_APP
  EMAIL
}

enum ReminderOccurrenceStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

/// Spec section "Important Date" - the core fact/event (not the reminder,
/// not the task - see the spec's explicit three-entity separation).
model ImportantDate {
  id       String @id @default(cuid())
  clientId String

  title    String
  /// Free-string catalog key - see schema-header comment above.
  type     String
  category ImportantDateCategory

  relatedEntityType String?
  relatedEntityName String?
  relationToClient  String?

  calendarType CalendarType @default(GREGORIAN)
  /// Gregorian: literal month (1-12)/day (1-31). Hebrew: Hebrew month
  /// number (1-13, Adar I/II both representable)/day (1-30). See
  /// lib/app-domain/important-dates-recurrence.ts for the conversion and
  /// every edge case (Feb 29, Adar I/II, variable Hebrew month lengths).
  month Int
  day   Int
  /// Optional origin year - spec: "שנה אופציונלית בימי הולדת וימי
  /// נישואים" / "הצגת גיל... רק אם שנת ההתחלה ידועה." Interpreted as a
  /// Gregorian year even when calendarType = HEBREW (the common case:
  /// someone knows they were born in 1990, not that they were born in
  /// 5750) - age/anniversary-years display always does a Gregorian-year
  /// subtraction from this field, never a Hebrew-year one.
  originYear Int?

  recurrence RecurrenceType @default(ANNUAL)
  /// Only meaningful when recurrence = CUSTOM_INTERVAL.
  customIntervalDays Int?
  /// Only meaningful when recurrence = ONCE - the exact one-time date;
  /// month/day/calendarType above are ignored for ONCE dates.
  onceDate DateTime?

  /// Feb 29 in a non-leap year: false (default, per spec) = Feb 28, true
  /// = Mar 1.
  leapDayUseMarchFirst Boolean @default(false)
  /// A Hebrew date recorded in Adar, observed during a 13-month Hebrew
  /// leap year: true (default, per spec) = Adar II, false = Adar I. Only
  /// consulted when calendarType = HEBREW and the recorded month is Adar.
  hebrewAdarTwoInLeapYear Boolean @default(true)

  timezone String @default("Asia/Jerusalem")

  responsibleUserId String
  /// Additional users who should see/be notified - a plain id list, same
  /// storage precedent as AlertRule.recipientsAnkora (String[], no join
  /// table, for what's just a short per-date list).
  additionalUserIds String[]
  extraEmailRecipients String[]

  status      ImportantDateStatus       @default(ACTIVE)
  sensitivity ImportantDateSensitivity  @default(NORMAL)
  notes       String?

  createAutoTask     Boolean @default(false)
  autoTaskLeadDays   Int?
  autoTaskCategoryId String?

  /// Cached, recomputed on every write and by the daily job - the next
  /// Gregorian date this important date falls on. Powers list/calendar
  /// sort and the dashboard/KPI cards without recomputing recurrence on
  /// every read.
  nextOccurrenceAt DateTime?
  /// The Gregorian anchor date of the CURRENT occurrence being tracked -
  /// once "today" passes this date, the daily job promotes the date to
  /// its next occurrence and resets status from HANDLED_CURRENT back to
  /// ACTIVE (spec: "לאחר מעבר למופע הבא, המועד חוזר למצב פעיל").
  currentOccurrenceAt DateTime?
  /// Snooze postpones reminders/handling without moving the event's own
  /// date (spec: "Snooze... לא לשנות את תאריך האירוע המקורי").
  snoozedUntil DateTime?

  source     ImportantDateSource @default(MANUAL)
  /// Set when source = HOLIDAY - which holiday-catalog key this row was
  /// generated from (important-dates-holidays.ts). Prevents re-creating
  /// the same holiday twice for a client even if it's reachable from two
  /// subscribed calendars (spec: "יש למנוע כפילות אם אותו חג מגיע משני
  /// לוחות").
  holidayKey String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser  User              @relation("ImportantDateResponsible", fields: [responsibleUserId], references: [id])
  createdBy        User?             @relation("ImportantDateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  autoTaskCategory Category?         @relation(fields: [autoTaskCategoryId], references: [id], onDelete: SetNull)
  reminderRules    ReminderRule[]
  occurrences      ReminderOccurrence[]
  tasks            Task[]

  @@unique([clientId, holidayKey])
  @@index([clientId, status, deletedAt])
  @@index([nextOccurrenceAt])
  @@index([responsibleUserId])
  @@map("important_dates")
}

/// Spec section "Reminder Rule" - how many days before, on which
/// channel(s), to whom.
model ReminderRule {
  id              String @id @default(cuid())
  importantDateId String

  daysBefore Int

  sendInApp Boolean @default(true)
  sendEmail Boolean @default(false)

  /// Extra Ankora-side recipients beyond the date's own
  /// responsible/additional users - same storage precedent as
  /// AlertRule.recipientsAnkora.
  extraAnkoraRecipients String[]
  /// Client-side recipients - stored per spec's own field list, but no
  /// write path sends to these yet in this MVP (client portal editing of
  /// dates is explicitly out of scope - see the spec's "לא לפתח עכשיו"
  /// list); keeping the column now avoids a migration if that changes.
  clientRecipients String[]

  enabled    Boolean @default(true)
  createTask Boolean @default(false)

  escalateToManager Boolean @default(false)
  escalateAfterDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importantDate ImportantDate        @relation(fields: [importantDateId], references: [id], onDelete: Cascade)
  occurrences   ReminderOccurrence[]

  @@index([importantDateId, enabled])
  @@map("reminder_rules")
}

/// Spec section "Reminder Occurrence / Delivery" - full send history, one
/// row per (date, occurrence year, rule, recipient, channel).
model ReminderOccurrence {
  id              String  @id @default(cuid())
  importantDateId String
  reminderRuleId  String?

  /// The Gregorian year of the specific ImportantDate occurrence this
  /// reminder belongs to - half of the idempotency key (spec: "המועד
  /// והמופע השנתי שאליהם ההתראה שייכת").
  occurrenceYear Int
  /// The anchor Gregorian date of that occurrence - stored directly (not
  /// only derived) so history stays readable even if the ImportantDate's
  /// own recurrence fields are edited later.
  occurrenceDate DateTime

  channel ReminderChannel

  recipientUserId String?
  recipientEmail  String?

  scheduledFor DateTime
  attemptedAt  DateTime?
  sentAt       DateTime?

  status   ReminderOccurrenceStatus @default(PENDING)
  error    String?
  attempts Int                      @default(0)

  providerMessageId String?

  /// The dedupe key itself (spec: "מפתח Idempotency ייחודי") - see
  /// lib/app-domain/important-dates-reminders.ts's buildIdempotencyKey.
  /// The unique constraint below is the real safety net; the daily job's
  /// own findFirst pre-check is only a friendlier early exit.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  importantDate ImportantDate @relation(fields: [importantDateId], references: [id], onDelete: Cascade)
  reminderRule  ReminderRule? @relation(fields: [reminderRuleId], references: [id], onDelete: SetNull)

  @@index([importantDateId, occurrenceYear])
  @@index([status, scheduledFor])
  @@map("reminder_occurrences")
}

/// Spec section "Holiday Calendar Subscription" - which holiday sets a
/// client is registered to; per-client, opt-in (spec: "אין להוסיף
/// אוטומטית את כל החגים לכל לקוח").
model HolidayCalendarSubscription {
  id       String @id @default(cuid())
  clientId String

  /// Which holiday set - a code-defined key (see
  /// lib/app-domain/important-dates-holidays.ts's HOLIDAY_CATALOG /
  /// HOLIDAY_CALENDAR_LABELS: currently "il_holidays" and
  /// "international_holidays") - a free String, not a DB enum, for the
  /// identical extensibility reason as ImportantDate.type: a new calendar
  /// is a catalog entry, never a migration.
  calendarKey String

  enabled Boolean @default(true)

  defaultReminderDaysBefore Int[]   @default([30, 7])
  responsibleUserId         String?
  createTasks                Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser User?  @relation("HolidaySubscriptionResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, calendarKey])
  @@map("holiday_calendar_subscriptions")
}
