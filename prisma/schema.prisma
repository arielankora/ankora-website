// Ankora Time Tracking - Phase 0/1 schema.
//
// Scope discipline: this file models ONLY what Phase 0 (schema/environments)
// and Phase 1 (auth, roles, users, clients, categories) require, per
// docs/adr/0001-time-tracking-app-architecture.md and spec section 23.
// Task/TimeEntry/HourBank/AlertRule/BillingPolicy/ReportSchedule/
// EmailDelivery/IntegrationConnection etc. belong to later phases and are
// deliberately NOT modeled yet - adding them now would be scope creep the
// spec's own "לא להמציא" instruction warns against.
//
// Conventions (spec section 0 / 25, non-negotiable defaults):
// - All timestamps stored in UTC (Prisma DateTime -> Postgres timestamptz).
// - Durations/money are never floats - not applicable yet in Phase 1 (no
//   TimeEntry/billing amounts here), but the convention is documented for
//   Phase 2+.
// - Soft delete only (deletedAt), never hard delete via the app.
// - Every credential-adjacent/administrative change must be auditable
//   (AuditEvent) - enforced in application code, not the DB, but the table
//   exists from Phase 1 onward so nothing is retrofitted later.

generator client {
  provider = "prisma-client-js"
}

// Two connection strings, and the reason is a deploy that failed twice in
// one day with a message that blamed the database.
//
//     Error: P1002
//     The database server was reached but timed out.
//     Context: Timed out trying to acquire a postgres advisory lock
//     (SELECT pg_advisory_lock(72707369)). Timeout: 10000ms.
//
// `prisma migrate deploy` takes one session-level advisory lock before it
// touches anything. `url` is Neon's POOLED endpoint, which is correct for
// the app (serverless opens far more connections than Postgres will hold)
// and wrong for that lock: the pooler hands a server connection back to
// the pool between statements, so the session that took the lock is not
// the session that tries to release it. The lock stays held by a
// connection nobody owns, and the next deploy waits ten seconds and dies.
//
// Measured rather than assumed: the second failure had no other build
// running. The queue explanation in claude/deploy-migration-lock covers
// the first one and cannot cover that.
//
// `directUrl` is where Prisma Migrate goes instead. Neon's Vercel
// integration already provides the unpooled string under this name, in
// both production and preview, so this costs no new secret. The runtime
// client keeps using `url` and keeps its pooling.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- Enums -------------------------------------------------------------

/// Internal Ankora staff roles, per spec section 4. Client-side portal
/// users are represented by CLIENT_USER + a per-client ClientUserRole
/// (see ClientUser below) rather than a fixed global role, since a client
/// user's authority is scoped to their own client, not global.
enum UserRole {
  SUPER_ADMIN
  ANKORA_ADMIN
  ANKORA_EMPLOYEE
  CLIENT_USER
}

/// Spec section 4.2 - explicit list.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Not explicitly enumerated in the spec beyond "status" - reasonable
/// default per section 25's "use a sensible default, but keep it
/// configurable" instruction. Documented in ADR-0001.
enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Client Admin vs Client Viewer, spec section 4 role table.
enum ClientUserRole {
  ADMIN
  VIEWER
}

/// Category.visibility, spec section 10.1.
enum CategoryVisibility {
  GLOBAL
  CLIENT
}

/// Task.status, spec section 5's data model + section 10.2: "סטטוסים: Open /
/// In progress / Done / Archived." Added in the Phase 9 gap-fix pass (spec
/// re-audit, docs/adr/0001 section 17.2) - the Task model existed since
/// Phase 2 but never had a status column, so every task was implicitly
/// "open" forever with no way to express otherwise.
enum TaskStatus {
  OPEN
  IN_PROGRESS
  // Tasks phase 2. Placed between IN_PROGRESS and DONE because Postgres
  // orders an enum by declaration and the tasks list sorts on status:
  // work waiting for a signature belongs beside work in progress, not
  // after everything that is finished.
  PENDING_APPROVAL
  DONE
  ARCHIVED
}

/// Task.priority. Four values and not five, because a scale people
/// actually use has a middle they can leave alone: NORMAL is the default
/// and the majority, HIGH and URGENT are the two that earn a look, and
/// LOW is the honest place for work that should exist without competing.
/// A five-point scale turns into "everything is a 3" within a month.
///
/// Deliberately NOT an Int. The Tasks screen sorts and filters on this,
/// and a number invites arithmetic on something that has no units.
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// --- Core models ---------------------------------------------------------

/// Every human who can log in - internal Ankora staff AND client-portal
/// users share this table (spec section 5 lists a single User entity).
/// What a given user can see/do is determined by `role` for internal
/// staff, and by their ClientUser row(s) for client-side users.
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  username     String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(INVITED)
  timezone     String     @default("Asia/Jerusalem")

  /// Employee agreements: a private address, collected at hiring. The
  /// work account is suspended the day someone leaves, and that is the
  /// day the deletion declaration has to reach them, so the work address
  /// is exactly the one that cannot be used for it.
  personalEmail String?

  /// App redesign, Profile screen (screen 18, docs/adr/0001 section 23):
  /// the one real per-user notification preference backing that screen's
  /// "התראות אישיות" toggle. Gates only the *email* half of
  /// notifyLongRunningTimers() (lib/app-domain/notifications.ts) - the
  /// persisted in-app Notification row (feeding /app/notifications and the
  /// header bell) is still created unconditionally either way. Default
  /// true preserves today's behavior for every existing row.
  notifyLongRunningTimerByEmail Boolean @default(true)

  /// Org brain, phase 3 (spec decision 5): may approve exceptions to a
  /// client's rules and sensitive information proposed for a client file.
  /// Given to a person, not to a role: Ariel and Hadas, whatever their
  /// roles are. A client that names its own approvers
  /// (Client.ruleApproverIds) overrides it for that client.
  canApproveExceptions Boolean @default(false)

  /// The morning digest, and the two columns behind it.
  ///
  /// Hadas, 25.9.2026: a task was opened on her and she did not notice.
  /// Two different failures hide in that sentence - she was never told,
  /// and there was nowhere quiet to look - and this is the second half.
  /// The first is the in-app notification the bell has been ready to
  /// show since phase 9 and that nothing on a task ever wrote to.
  ///
  /// `dailyDigestAt` is WHEN THE LAST ONE WENT, not a preference. The
  /// obvious implementation of "what is new" is a fixed 24-hour window,
  /// and it drops work silently: the week here runs Sunday to Thursday,
  /// so Sunday's email has to cover everything since Thursday
  /// afternoon. A remembered timestamp covers a long weekend, a holiday
  /// and a day the cron did not run, and a fixed window covers none of
  /// them.
  ///
  /// `dailyDigestByEmail` follows the precedent above it. An alert
  /// somebody cannot turn off is an alert they filter, and a filtered
  /// email is worse than no email at all, because everyone keeps
  /// believing it arrived.
  dailyDigestByEmail Boolean   @default(true)
  dailyDigestAt      DateTime?

  /// Incremented to invalidate every previously-issued session JWT at once
  /// (spec 4.2: "logout all sessions" for admins) without needing a
  /// database-backed session table for a Credentials-only auth flow.
  tokenVersion Int @default(0)

  /// Spec 4.2: "Rate limiting ו-lockout הדרגתי לניסיונות כושלים." A simple
  /// persisted counter + lockout window - correct for MVP scale, and
  /// persisted (rather than in-memory) because serverless functions don't
  /// share memory between invocations.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Two-step sign-in (16.10.2026). A client who turned on "ask for a
  /// passkey at every sign-in". Ankora staff do not use this flag: for
  /// them the passkey is required by role on every Vercel deployment
  /// (lib/app-auth/second-factor.ts).
  loginPasskeyRequired Boolean @default(false)

  lastLoginAt DateTime?
  /// The last time this person did anything: a page load with a valid
  /// session, or an MCP call. lastLoginAt moves only on a sign-in, and a
  /// session lives for weeks, so it says nothing about whether someone is
  /// still working; this does. Written at most once an hour per person
  /// (lib/app-auth/last-seen.ts).
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clientMemberships   ClientUser[]
  clientAccess        UserClientAccess[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
  portalLoginTokens   PortalLoginToken[]
  timeEntries         TimeEntry[]
  timeEntryRevisions  TimeEntryRevision[]  @relation("TimeEntryRevisionActor")
  hourBankAdjustments HourBankAdjustment[] @relation("HourBankAdjustmentCreator")
  notifications       Notification[]

  // Phase 10: Important Dates (מועדים חשובים).
  assignedTasks              Task[]                        @relation("TaskAssignee")
  supervisedTasks            Task[]                        @relation("TaskSupervisor")
  taskComments               TaskComment[]                 @relation("TaskCommentAuthor")
  taskPlansWritten           TaskPlan[]                    @relation("TaskPlanAuthor")
  taskPlansApproved          TaskPlan[]                    @relation("TaskPlanApprover")
  approvedTasks              Task[]                        @relation("TaskApprover")
  importantDatesResponsible  ImportantDate[]                @relation("ImportantDateResponsible")
  importantDatesCreated      ImportantDate[]                @relation("ImportantDateCreator")
  holidaySubscriptionsOwned  HolidayCalendarSubscription[]  @relation("HolidaySubscriptionResponsible")

  // Phase 13: MCP server (docs/adr/0005).
  mcpAccessTokens McpAccessToken[]

  // Phase 15: MCP OAuth (docs/adr/0005).
  oauthCodes  OAuthAuthorizationCode[]
  oauthTokens OAuthToken[]

  // Portal phase 2.
  managedClients    Client[]           @relation("ClientAccountManager")
  decisionsOpened   Decision[]         @relation("DecisionAuthor")
  decisionResponses DecisionResponse[] @relation("DecisionResponder")

  // Portal phase 3.
  preferencesTouched  Client[]         @relation("ClientPreferencesEditor")
  documentsUploaded   ClientDocument[] @relation("ClientDocumentUploader")
  summariesApproved   PortalSummary[]  @relation("PortalSummaryApprover")
  credentialsCreated  ClientCredential[] @relation("CredentialCreator")
  credentialsUpdated  ClientCredential[] @relation("CredentialUpdater")
  credentialsRevealed ClientCredential[] @relation("CredentialLastRevealer")
  stepUpGrants        StepUpGrant[]
  passkeys            Passkey[]
  webauthnChallenges  WebAuthnChallenge[]
  pendingLogins       PendingLogin[]
  deviceLinkCode      DeviceLinkCode?

  // Employee agreements.
  employeeAgreements EmployeeAgreement[]
  // Employee lifecycle: onboarding and offboarding tasks about this person.
  lifecycleTasks     Task[]              @relation("TaskSubject")
  agreementSignLinks AgreementSignLink[]

  @@index([role, status])
  @@map("users")
}

/// Spec 4.2: "Forgot password באמצעות link חד-פעמי עם expiry." Only the
/// SHA-256 hash of the token is stored - the raw token exists only in the
/// emailed link, same principle as never storing plaintext passwords.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Portal phase 0: a one-time sign-in link for a CLIENT_USER. Same
/// hash-only storage as PasswordResetToken above, and deliberately a
/// separate table rather than a reused reset token: a reset token grants
/// the right to CHANGE A PASSWORD, this one grants a SESSION, and the two
/// must never be interchangeable (a leaked reset link would otherwise log
/// the finder straight in, and a leaked login link would let them take the
/// account over). Short TTL, single use, and only ever issued to a
/// CLIENT_USER - Ankora staff keep password sign-in.
model PortalLoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portal_login_tokens")
}

/// Phase 13 (docs/adr/0005): a personal access token that lets ONE Ankora
/// employee reach the MCP server at /api/mcp from their own Claude
/// Desktop. Deliberately per-user and never per-organization: every tool
/// call resolves this row to a real `User` and runs through the same
/// `assertCan`/`listAccessibleClients` checks a screen does, so a shared
/// credential would erase the entire RBAC model (lib/app-auth/
/// permissions.ts) and leave every AuditEvent pointing at the same actor.
///
/// Only the SHA-256 hash is stored, exactly like PasswordResetToken above
/// and for the identical reason. Note this is a *different* pattern from
/// lib/cron-auth.ts's constant-time compare, on purpose: that endpoint
/// compares one presented string against one known secret, which needs
/// timingSafeEqual; here the presented token is hashed first and used as
/// an indexed lookup key, so a wrong token simply finds no row and there
/// is no per-byte comparison to time.
///
/// `expiresAt` is mandatory (no never-expiring tokens). Revocation has two
/// independent paths: `revokedAt` on this row, and User.tokenVersion - see
/// lib/mcp/auth.ts for why the second one matters.
model McpAccessToken {
  id         String    @id @default(cuid())
  userId     String
  /// Human-readable label so a user can tell two of their own tokens apart
  /// when revoking one ("MacBook Air", "old laptop").
  label      String
  tokenHash  String    @unique
  /// Snapshot of User.tokenVersion when the token was issued. A later
  /// "logout all sessions" bumps the user's counter past this value and
  /// the token stops resolving - see lib/mcp/auth.ts.
  tokenVersion Int     @default(0)
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("mcp_access_tokens")
}

/// Phase 15 (MCP OAuth, docs/adr/0005): an OAuth client Claude registered
/// with us.
///
/// Claude registers a fresh client on every new connection via Dynamic
/// Client Registration (RFC 7591), so rows here accumulate one per
/// connection rather than one per product. That is expected and is why
/// `lastUsedAt` exists - stale rows are prunable.
///
/// `clientSecretHash` is nullable because DCR registers Claude as a
/// PUBLIC client: it authenticates at the token endpoint with PKCE and no
/// secret. A secret is stored only if a confidential client ever
/// registers one, and it is hashed for the same reason every other
/// credential in this schema is.
model OAuthClient {
  id               String    @id @default(cuid())
  clientId         String    @unique
  clientSecretHash String?
  clientName       String
  /// Exact strings the client registered. Matching is exact, except for
  /// RFC 8252 loopback URIs where the port is ignored - see
  /// lib/mcp/oauth/redirect.ts for why that exception is required and how
  /// narrowly it is applied.
  redirectUris     String[]
  grantTypes       String[]
  scopes           String[]
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?

  codes  OAuthAuthorizationCode[]
  tokens OAuthToken[]

  @@map("oauth_clients")
}

/// Phase 15: a single-use authorization code, bound to a PKCE challenge.
///
/// Short-lived by design (RFC 6749 recommends under ten minutes) and
/// single-use: `consumedAt` is what makes a replayed code fail. Only the
/// hash is stored, same principle as PasswordResetToken and
/// McpAccessToken.
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  userId              String
  redirectUri         String
  scope               String
  codeChallenge       String
  codeChallengeMethod String
  /// RFC 8707 resource indicator: which MCP server this code is for. Bound
  /// at authorization time and echoed into the token, so a code minted for
  /// one resource cannot be exchanged for a token valid at another.
  resource            String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_authorization_codes")
}

/// Phase 15: an issued access token and the refresh token that renews it.
///
/// One row per access/refresh pair. Refresh rotation (required for public
/// clients by the MCP authorization spec) creates a NEW row and points the
/// old one at it via `rotatedToId`, rather than mutating in place - so a
/// stolen-and-replayed refresh token is visible as an attempt to reuse a
/// row that already rotated, instead of being indistinguishable from
/// normal use.
///
/// `tokenVersion` snapshots User.tokenVersion at issue, exactly as
/// McpAccessToken does, so "logout all sessions" revokes OAuth grants too.
model OAuthToken {
  id               String    @id @default(cuid())
  clientId         String
  userId           String
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  scope            String
  resource         String?
  tokenVersion     Int       @default(0)
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  /// Set when this row's refresh token was exchanged for a new pair.
  rotatedToId      String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([clientId])
  @@map("oauth_tokens")
}

/// A customer of Ankora. Billing policy / hour bank fields are
/// deliberately NOT modeled here yet (Phase 3) - only what Phase 1's
/// "clients" epic needs: identity, status, contact/timezone, and the
/// relations that make RBAC and categories work.
model Client {
  id             String       @id @default(cuid())
  name           String
  legalName      String?
  status         ClientStatus @default(ACTIVE)
  timezone       String       @default("Asia/Jerusalem")
  primaryContact String?

  /// Phase 6 (spec 13/14.1: "employee name configurable"). Whether the
  /// Client Portal's Weekly Activity / Monthly Detailed reports show which
  /// Ankora employee performed each entry, or omit that column entirely.
  /// Spec section 25 gives no explicit default for this specific toggle,
  /// so it defaults to true (maximum transparency, matching the spec's
  /// stated purpose for the whole portal - section 13: "לתת ללקוחות
  /// שקיפות מבוקרת") - Ankora can flip it per client if a contract
  /// requires anonymity. Documented in docs/adr/0001's Phase 6 addendum.
  portalShowEmployeeNames Boolean @default(true)

  /// Ankora's own internal work (onboarding, training, internal
  /// projects) is logged against a client record like any other, so the
  /// timer and the reports keep working. It is not client work, though,
  /// and the home-page hours chart leaves it out: that chart answers
  /// "how much did we work for clients", and internal hours there read
  /// as a client that does not exist (9.10.2026, Ariel).
  isInternal Boolean @default(false)

  /// Org brain (spec 3.3): a business or a private person, and in a few
  /// words what they do ("חברה, סטארטאפ AI"). One file template for both
  /// (decision 7); the kind says which sections a reader expects to see
  /// empty.
  kind     ClientKind @default(BUSINESS)
  industry String?

  /// Portal phase 2. Who at Ankora owns this client operationally. Shown
  /// on the portal's home screen and named on every decision, because a
  /// decision arrives from a person, not from a system - and because a
  /// client who does not know whose desk their request sits on has not
  /// had their mental load removed, only moved.
  accountManagerId String?

  /// Org brain, phase 3 (spec decision 5): who approves exceptions to this
  /// client's rules and sensitive information for its file, when the
  /// client said who ("medical information only with Ariel's prior
  /// approval"). Empty: anyone with User.canApproveExceptions.
  ruleApproverIds String[] @default([])

  /// The dedicated WhatsApp line this client already talks to Ankora on.
  /// Stored per client (not per employee) because that is how it works
  /// today: the thread exists before the portal does, and the portal's
  /// job is to shorten the way to it, never to open a second channel.
  /// Null means no line is recorded yet, and the portal says so rather
  /// than rendering a button that goes nowhere.
  whatsappNumber String?

  /// The spending ceiling agreed with this client, in agorot. Above it,
  /// the service agreement requires the client's approval in writing
  /// before Ankora commits money on their behalf - which is exactly what
  /// a decision recorded in the portal is. Null means no ceiling was
  /// agreed, and every priced decision then needs an approval.
  ///
  /// Agorot rather than shekels for the same reason money is stored in
  /// minor units everywhere: 149.90 is not representable as a float, and
  /// a rounding error in a number that appears on an approval is a
  /// number someone will eventually dispute.
  approvalCeilingMinor Int?

  /// Portal phase 3, screen 5 ("התיק שלי"). The three questions the
  /// intake call already asks, kept in the client's own words: how they
  /// want to be spoken to, what matters to them, and what must never
  /// happen. Free text rather than a set of toggles because the half of
  /// each answer worth having is the half no enum has a box for - "אל
  /// תתקשרו לפני תשע" and "בלי הפתעות בחשבון" are the whole point.
  ///
  /// Both sides edit them. When the client edits, their account manager
  /// is told, which is why the last editor is recorded rather than only
  /// the time.
  preferenceContact String?
  preferenceMatters String?
  preferenceNever   String?
  preferencesUpdatedAt   DateTime?
  preferencesUpdatedById String?

  /// How often this client wants the portal to reach out. Theirs to set,
  /// from their own screen - the spec's second notification rule.
  portalDigest PortalDigest @default(EVERY_DECISION)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portalUsers  ClientUser[]
  employeeAccess UserClientAccess[]
  categories   Category[]
  auditEvents  AuditEvent[] @relation("AuditClient")
  tasks        Task[]
  timeEntries  TimeEntry[]
  billingPolicy       BillingPolicy?
  hourBanks           HourBank[]
  hourBankAdjustments HourBankAdjustment[]
  alertRules          AlertRule[]
  reportSchedules     ReportSchedule[]

  // Phase 10: Important Dates (מועדים חשובים).
  importantDates       ImportantDate[]
  holidaySubscriptions HolidayCalendarSubscription[]

  // Portal phase 2.
  accountManager User?      @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  decisions      Decision[]

  // Portal phase 3.
  preferencesUpdatedBy User?            @relation("ClientPreferencesEditor", fields: [preferencesUpdatedById], references: [id], onDelete: SetNull)
  documents            ClientDocument[]
  credentials          ClientCredential[]
  portalSummaries      PortalSummary[]

  // Org brain, phase 2 (spec 3.5).
  contacts      ClientContact[]
  organizations ClientOrganization[]
  sources       ClientSource[]
  domains       ClientDomain[]
  systems       SystemAccess[]
  facts         ClientFact[]
  entities      ClientEntity[]
  knowledgeBatches KnowledgeBatch[]
  requestTypes     RequestType[]
  narratives       ClientNarrative[]
  policies         ClientPolicy[]
  policyExceptions PolicyException[]
  processes        Process[]

  @@index([status])
  @@index([accountManagerId])
  @@map("clients")
}

/// Links a User (role=CLIENT_USER) to the Client they belong to, with
/// their client-scoped role. Spec section 5: ClientUser(client_id,
/// user_id, client_role).
model ClientUser {
  id       String         @id @default(cuid())
  clientId String
  userId   String
  role     ClientUserRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_users")
}

/// Which clients an Ankora employee is allowed to report time against /
/// view. Spec 4.1: "לכל עובד ניתן להגדיר רשימת לקוחות מורשים." Kept as a
/// plain assignment table in Phase 1 - granular per-assignment
/// permissions (e.g. edit-others override) are a Phase 2+ concern once
/// TimeEntry exists to actually scope.
model UserClientAccess {
  id       String @id @default(cuid())
  userId   String
  clientId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_access")
}

/// Global or client-specific work categories. Spec section 10.1.
model Category {
  id          String             @id @default(cuid())
  name        String
  description String?
  active      Boolean            @default(true)
  visibility  CategoryVisibility @default(GLOBAL)
  /// Required when visibility = CLIENT, null when GLOBAL.
  clientId    String?
  sortOrder   Int                @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeEntries TimeEntry[]
  // Phase 10: Important Dates (מועדים חשובים) - category an auto-created
  // task should use when ImportantDate.createAutoTask = true.
  importantDatesAutoTaskCategory ImportantDate[]

  @@index([visibility, clientId, active])
  @@map("categories")
}

/// Append-only audit trail. Spec section 16.1 lists the Phase-1-relevant
/// event types this must cover from day one: login success/failure,
/// user role/access change, client settings change. Never updated or
/// deleted from the application - read-only in the Admin UI (section 12).
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  clientId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  client Client? @relation("AuditClient", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Phase 2: Timer + TimeEntry + manual entry + audit revisions ---------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 2"):
// only Task/TimeEntry/TimeEntryRevision are modeled here. HourBank,
// AlertRule, BillingPolicy, ReportSchedule, EmailDelivery,
// IntegrationConnection remain out of scope until Phase 3+ - adding them
// now would be the same scope creep Phase 1's header comment warned
// against. billableSeconds defaults to actualSeconds (no BillingPolicy
// exists yet to diverge them); the column exists now per spec section 5
// so Phase 3 doesn't need a backfill migration.
//
// IMPORTANT - constraint that lives ONLY in the hand-authored migration
// SQL, not expressible in this file. Prisma's schema DSL has no portable
// way to declare a partial unique index, so the enforcement is a Postgres
// partial unique index created directly in prisma/migrations/:
//   CREATE UNIQUE INDEX time_entries_one_active_per_user_client
//     ON time_entries ("userId", "clientId")
//     WHERE "endAt" IS NULL AND "deletedAt" IS NULL;
// History: Phase 2 allowed one active timer per user (index on userId
// alone). 5.10.2026 (migration 20261005120000) allows parallel timers on
// different clients, so the index moved to (userId, clientId): two
// timers on the same client stay impossible under any race. The cap of
// MAX_PARALLEL_TIMERS per user cannot be an index; startTimer enforces
// it under a per-user advisory lock (lib/app-domain/time-entries.ts).
// The deletedAt half of the predicate is not decoration: without it the
// index and getActiveTimers disagree about what "active" means, and a
// soft-deleted running timer blocks every future start with an error
// nobody can clear - the 24.9.2026 report, migration 20260924120000.
// If this file and the migration ever appear to drift on this specific
// index, the migration is the source of truth;
// do not let a Prisma-generated migration silently drop it.

/// Phase 14 (MCP server writes, docs/adr/0005): WHERE an entry was created
/// from, which is a different question from TimeEntrySource's HOW (a timer
/// vs a typed form). Both matter: "Claude started a timer" is TIMER+MCP,
/// "Ariel typed one in" is MANUAL+APP.
///
/// Without this column there is no way to tell an entry a person typed
/// from one an agent created, and the first bad write would be
/// untraceable - AuditEvent records who acted, not through what. Defaults
/// to APP so every existing row is correctly labelled by the migration.
enum EntryOrigin {
  APP
  MCP
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

/// Free-text-first per spec 6.1 ("Task יכולה להיות free-text ב-MVP אך
/// נשמרת כישות אם המשתמש בוחר 'צור משימה'"). Phase 2 only needs enough of
/// this entity for TimeEntry.taskId to point somewhere and for the
/// ClickUp-shaped source/externalRef columns to already exist (spec 10) -
/// a full Tasks management screen is not part of Phase 2's stated scope
/// ("Timer + TimeEntry + manual entry + audit revisions") and is deferred.
/// Who or what a blocked task is waiting on.
///
/// Four values, because the answer a person needs is "is this on us or
/// on them", and a longer list turns a one-second choice into a menu.
/// CLIENT is the only one the portal surfaces, as the "מחכה לך" stage:
/// a task waiting on a supplier is "בטיפול" from where the client sits,
/// which is exactly what it is.
enum TaskBlocker {
  CLIENT
  SUPPLIER
  INTERNAL
  OTHER
}

model Task {
  id          String    @id @default(cuid())
  clientId    String
  categoryId  String?
  title       String
  status      TaskStatus @default(OPEN)
  source      String    @default("local")
  externalRef String?

  // Phase 10 (Important Dates, "מועדים חשובים"): the spec asks to extend
  // Task with assignee + due date + a link back to the ImportantDate/
  // occurrence that auto-created it, "אם השדות עדיין אינם קיימים" - none
  // of these four existed before this phase. assignedToId/dueDate are
  // useful for ANY task (not only auto-created ones), so they're plain
  // optional columns, not important-dates-specific. importantDateId +
  // importantDateOccurrenceKey exist ONLY on auto-created rows and are
  // the "one task per (date, occurrence-year)" dedupe guard (spec: "אם
  // קיימת משימה פתוחה הקשורה לאותו מועד ומופע, אין ליצור נוספת") - a
  // unique constraint on the pair is the actual safety net (Postgres
  // treats these as distinct when both are NULL, i.e. ordinary
  // manually-created tasks never collide with each other here), mirroring
  // ReminderOccurrence.idempotencyKey's precedent below.
  assignedToId               String?
  dueDate                    DateTime?
  importantDateId            String?
  importantDateOccurrenceKey String?

  /// Org brain, phase 1 (spec 3.12): a run of a process is a task. It
  /// remembers which process and which approved version of the procedure
  /// it was opened from, so a later version never rewrites a run already
  /// under way. On a step of a run, `stepMode` is how that step is done.
  processId        String?
  processVersionId String?
  stepMode         ProcessStepMode?

  // Portal phase 1 ("הבטחות"). Three fields, and deliberately not a
  // second status column.
  //
  // `clientVisible` is opt-in per task: not every internal task is a
  // promise to the client (chasing an invoice we owe, a note to self,
  // a task opened to park a thought), and a portal that shows all of
  // them teaches the client to read our workflow instead of their own
  // outcomes.
  //
  // `clientTitle` is the sentence the client reads. It falls back to
  // `title` when empty, so nothing is ever blank - but the two exist
  // separately because an internal title like "לבדוק מול הסוכן שוב"
  // is not what a client should see, and rewriting it in place would
  // cost the team the shorthand they work with.
  //
  // The client-facing stage the portal shows is derived, never stored:
  // התקבל / בטיפול / מחכה לך / הושלם come from `status` plus the block
  // fields below. A parallel client-stage enum would have to be kept in
  // sync by hand on every change, which is the kind of dual write that
  // silently drifts and then shows a client a task marked "בטיפול"
  // that closed last week.
  clientVisible        Boolean   @default(false)
  clientTitle          String?
  /// What we are asking the client to do, in one sentence addressed to
  /// them, shown under "מחכה לך" while the task waits on the client.
  /// Separate from `blockedReason` on purpose: that one is our internal
  /// note ("לא עונה לטלפון") and must never reach the client
  /// (tests/integration/task-blocking.test.ts). NUX handover, 3.10.2026.
  clientRequest        String?

  // Portal phase 3 ("ספקים וגורמים"), and deliberately not a Supplier
  // table.
  //
  // The 22.9.2026 decision on the spec: a supplier is recorded as one
  // field on the task at the moment it closes, and the client's supplier
  // list is derived from their tasks rather than maintained beside them.
  // A separate entity would be a second place to type the same name, and
  // a second place to type something is the first thing abandoned under
  // load - which would leave the client's file confidently empty.
  //
  // `supplierExperience` is the "ואיך היה" of the spec's own phrasing. It
  // is three values rather than five stars because the person filling it
  // in is closing a task, not writing a review, and because the only
  // question the client ever asks of it is whether to use them again.
  //
  // `supplierRecordedAt` is the "when": set when the line is filled,
  // which is at closing. The task's own updatedAt would move again on
  // every later edit and stop meaning anything.
  supplierName       String?
  supplierExperience SupplierExperience?
  supplierRecordedAt DateTime?

  // Team adoption ("אימוץ בצוות"), and the answer to a gap the portal has
  // carried since phase 1: a promise could be marked done without anyone
  // ever saying what happened.
  //
  // `clientOutcome` is the definition of done. `clientTitle` is what the
  // thing was called; this is what came of it, in the client's language,
  // and a client-visible task cannot reach DONE without it - see
  // updateTask. It is the field that feeds the activity screen and the
  // monthly summary, both of which were assembling themselves out of
  // titles alone.
  //
  // `completedAt` is the moment it closed, written by the server on the
  // transition into DONE and cleared if a task is reopened. The portal
  // used `updatedAt` for this, which moves again whenever anyone touches
  // the row - so a client could see work finished three weeks ago dated
  // today, because someone fixed a typo in its title.
  clientOutcome String?
  completedAt   DateTime?

  // Tasks phase 1 ("מסך המשימה"), and the three things a task could not
  // say about itself.
  //
  // `description` is the first place in this model where a task can hold
  // more than a line. Until now the only text on a task was `title`, so
  // every address, phone number, reference number and instruction lived
  // in WhatsApp, and a colleague picking the task up had to go and ask.
  // Markdown as plain text, sanitised on render - see the tasks-system
  // spec's decision 4 for why this is not a rich-text editor.
  //
  // `priority` is what the list has never been able to say: these four
  // are today and the rest are not. Defaulted so no existing row needs a
  // backfill and no form needs a required field.
  //
  // `startedAt` is the counterpart to `completedAt`, which the team
  // adoption phase added without it. Written by the server on the first
  // transition into IN_PROGRESS and never moved again - a task that goes
  // back and forth keeps the moment work actually began on it, because
  // that is the number cycle time is measured from. Cleared only when a
  // task returns all the way to OPEN, which is a person saying the work
  // has not in fact started.
  description String?
  priority    TaskPriority @default(NORMAL)
  startedAt   DateTime?

  // Tasks phase 2 ("מפקח ואישור"), and the difference between a task
  // somebody is responsible for and a task somebody signs off.
  //
  // `supervisorId` is the second person on a task. Not a second
  // assignee: the assignee does the work, the supervisor is who it goes
  // back to. Nullable, because most work needs no second pair of eyes,
  // and a required field here would be filled in with whoever happens to
  // be at the top of the list.
  //
  // `requiresApproval` is a separate switch from `supervisorId` on
  // purpose. Hadas asked for both modes: somebody who wants to know, and
  // somebody who has to agree. Watching is the supervisor alone; signing
  // off is the supervisor plus this flag. One column meaning both would
  // turn every watcher into a gate and teach the team to leave the field
  // empty rather than slow themselves down.
  //
  // `approvedById` and `approvedAt` record the signature. Written by the
  // server on the move out of PENDING_APPROVAL into DONE and cleared if
  // the task is reopened, exactly like `completedAt` - an approval that
  // survived a reopen would be a signature on work that changed after it
  // was given.
  supervisorId     String?
  /// Tasks phase 5. Null means this is a task in its own right.
  parentId     String?
  requiresApproval Boolean   @default(false)
  approvedById     String?
  approvedAt       DateTime?

  // Tasks phase 5 ("חסימה פשוטה"), and the generalisation of a field
  // that has been here since portal phase 1.
  //
  // `waitingOnClientSince` was this, for one blocker. The portal read it
  // as the "מחכה לך" stage, the list had a one-click toggle for it, and
  // the timer wrote it when somebody stopped the clock on a promise. It
  // covered the commonest wait in this business and none of the others:
  // a supplier who has not quoted, a municipality that has not replied,
  // an internal sign-off. Those were invisible, so a task that everybody
  // was right to leave alone looked exactly like a task nobody had
  // touched.
  //
  // Adding a second "waiting" field beside it was the obvious move and
  // the wrong one. Two columns that both mean "we are waiting" is the
  // dual write this schema warns about three times elsewhere, and it
  // drifts on the second day. So the old field became these three.
  //
  // **A flag, not a status.** `BLOCKED` is deliberately NOT in
  // TaskStatus: every filter, every count and every board column would
  // have to decide about it, and the board would grow a fifth column,
  // which is where work goes to die. "In progress, and waiting on the
  // client since Tuesday" is a more accurate description of the world
  // than "blocked".
  //
  // `blockedSince` is written by the server on the transition into
  // blocked and never moved again, exactly like `startedAt` and
  // `supplierRecordedAt`. Editing the reason a week later must not
  // reset the clock, because the age is the entire point: "waiting"
  // with no age is a place to hide work.
  //
  // `blockedOn` is required whenever the task is blocked, and
  // `blockedReason` is not. That asymmetry is deliberate: the two
  // one-click gestures already in production (the list toggle and the
  // timer's stage buttons) mean "waiting on the client", and putting a
  // required text field in front of a fast gesture is how a good field
  // gets routed around. The task screen offers both together.
  blockedSince  DateTime?
  blockedOn     TaskBlocker?
  blockedReason String?

  // Employee lifecycle (15.10.2026): a task ABOUT a person, as opposed to
  // one assigned TO a person. Opened by the server when a staff member
  // is invited (onboarding) or suspended (offboarding), so the system can
  // find that task again by who it is about: to close the confidentiality
  // step when the person signs, to note the deletion declaration when it
  // comes back, and to refuse opening a second offboarding task.
  //
  // SetNull rather than Restrict. The task is a record of work Ankora
  // did, and its title and description already name the person; a hard
  // delete of the user row (which this product never does on its own)
  // should not be blocked by a checklist. The signatures themselves are
  // the evidence that must outlive the person, and those restrict.
  subjectUserId String?
  lifecycleKind EmployeeLifecycleKind?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  supervisor    User?          @relation("TaskSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approvedBy    User?          @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  /// Tasks phase 5: the task this one is a step of.
  ///
  /// ONE level, enforced in createTask: a subtask cannot have subtasks.
  /// A tree is a navigation problem, and this product's tasks live for
  /// days. One level is a checklist whose items happen to be real tasks,
  /// so a step can carry its own assignee, deadline and timer without
  /// anybody learning a second concept.
  ///
  /// Cascade on delete, unlike every other relation here: a step has no
  /// meaning without the thing it is a step of. Deletes in this product
  /// are soft, so this fires only if a row is ever truly removed.
  parent        Task?          @relation("TaskParent", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("TaskParent")
  importantDate ImportantDate? @relation(fields: [importantDateId], references: [id], onDelete: SetNull)
  subjectUser   User?          @relation("TaskSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  timeEntries   TimeEntry[]
  decisions     Decision[]
  documents     ClientDocument[]
  comments      TaskComment[]
  plans         TaskPlan[]

  @@unique([importantDateId, importantDateOccurrenceKey])
  @@index([processId])
  @@index([subjectUserId, lifecycleKind])
  @@index([clientId])
  @@index([assignedToId])
  // Portal phase 1: every portal screen reads this client's visible tasks.
  @@index([clientId, clientVisible])
  // Portal phase 3: the client's file lists suppliers newest first.
  @@index([clientId, supplierRecordedAt])
  // Tasks phase 1: the list sorts urgent work to the top within a status.
  @@index([status, priority, dueDate])
  // Tasks phase 2: the supervision screen reads one person's tasks, the
  // ones waiting on their signature first.
  @@index([supervisorId, status])
  // Team adoption: promises that have not moved, for the manager's metric
  // and for one person's own rows on the home screen.
  @@index([clientVisible, status, updatedAt])
  /// Every screen that lists work asks "and which of these are steps of
  /// something else", so this is read on almost every task query.
  @@index([parentId, status])
  /// Tasks phase 5: "what are we waiting on, and for how long". Leading
  /// with the blocker so the common question ("which of these is the
  /// client sitting on") does not scan every blocked row.
  @@index([blockedOn, blockedSince])
  @@map("tasks")
}

/// Tasks phase 3 ("שרשור"), and the third of Hadas's three requests.
///
/// What a task could not hold until now is the conversation around it.
/// Everything a colleague needed to know that was not a field lived in
/// WhatsApp: what was tried, who answered, what the supplier said. A task
/// somebody picks up two weeks later carried the title and nothing else.
///
/// **Internal, and there is no `clientVisible` column here on purpose.**
/// The client-facing sentence is `Task.clientOutcome`, which already
/// exists, already reaches the portal and already gates closing a
/// promise. A second client-facing channel would mean two places to write
/// to a client and two places to check before saying something, which is
/// how one of them quietly stops being read. Raising a single comment to
/// an interim update for the client is a real idea and it is the next
/// increment, not this one.
///
/// The thread on the screen is NOT this table. It is these rows merged at
/// read time with the AuditEvent rows the product has recorded since
/// phase 1, and with the files filed against the task, so "who changed
/// the status", "what Dana said about it" and "the quote arrived" sit in
/// one list in the order they happened. Nothing is written twice; see the
/// tasks-system spec's decision 1.
model TaskComment {
  id       String  @id @default(cuid())
  taskId   String
  /// Nullable for the same reason an audit actor is: a comment written
  /// by a job has no person behind it, and a person who leaves should
  /// not take their words out of the thread with them.
  authorId String?

  /// Markdown as plain text, exactly as `Task.description` holds it.
  /// Rendered by lib/markdown-lite.ts, which escapes first and applies
  /// patterns second. Nothing stores HTML.
  body String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft, like every other delete in this product. A thread that can
  /// lose entries without trace is a thread nobody can rely on.
  deletedAt DateTime?

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// "קדם עם קלוד" (10.10.2026): the work plan of a task, one row per version.
///
/// Not `Task.description` and not the steps, on purpose. The description is
/// the brief a person wrote, and the plan is built FROM it: writing the plan
/// over it would erase its own source. The steps are a checklist with a
/// status, one line each and fifteen at most. A plan carries what a line
/// cannot: why, in what order, who does each part, what could go wrong and
/// what "done" means. The two meet in `steps` below, the one-line titles the
/// plan proposes, which a person can turn into real steps with one click.
///
/// **Versions, never an edit in place.** Every save is a new row with the
/// next number, so the history of how a plan changed is the table itself,
/// and a save that was written against an older version than the one now
/// stored is refused instead of overwriting it (saveTaskPlan). The current
/// plan is simply the highest version; there is no "superseded" status to
/// keep in sync by hand.
///
/// Internal, like the comment thread. Nothing here reaches the portal.
model TaskPlan {
  id      String @id @default(cuid())
  taskId  String
  /// 1, 2, 3... per task. Unique with taskId, which is also what stops two
  /// saves that raced past the version check from both landing.
  version Int

  /// Markdown as plain text, rendered by lib/markdown-lite.ts like every
  /// other text on a task. Nothing stores HTML.
  body  String
  /// The one-line step titles the plan proposes, in order. Empty when the
  /// plan proposes none. Copied into real steps only on request.
  steps String[] @default([])

  status TaskPlanStatus @default(APPROVED)
  /// Where it was written: through Claude (MCP) or on the task screen.
  origin EntryOrigin    @default(APP)
  /// What changed from the previous version, in one line. Optional.
  changeNote String?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  /// Set when this version's steps were copied into the task's steps.
  stepsAppliedAt DateTime?

  createdAt DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy  User? @relation("TaskPlanAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("TaskPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([taskId, version])
  @@map("task_plans")
}

enum TaskPlanStatus {
  /// Written, not yet agreed. Claude saves one only when asked to.
  DRAFT
  /// Agreed by the person whose connection or session saved or approved it.
  APPROVED
}

/// Spec section 5 + 6. A row with endAt = null is a currently-running
/// timer (source=TIMER). Manual entries (source=MANUAL) always have both
/// startAt and endAt set at creation. actualSeconds/billableSeconds are
/// null while a timer is running and computed on stop.
model TimeEntry {
  id     String @id @default(cuid())
  userId String

  clientId   String
  categoryId String
  taskId     String?

  startAt DateTime
  endAt   DateTime?

  /// Server-computed only (spec 18.1: "server end time + compute actual"),
  /// never trusted from the client. Null while a timer is actively running.
  actualSeconds Int?
  /// Defaults to actualSeconds once BillingPolicy exists in Phase 3 to
  /// diverge them (spec section 7).
  billableSeconds Int?

  note String?

  source   TimeEntrySource @default(MANUAL)
  isManual Boolean         @default(false)
  /// True once any post-creation edit has produced a TimeEntryRevision.
  /// Spec 6.4: "כל עריכה ידנית מסומנת באייקון פנימי 'Edited'."
  isEdited Boolean         @default(false)
  /// Spec "אישור דיווח שעות חופף בין לקוחות שונים" (Phase 12): true when
  /// this entry was only saved because an overlap with another entry for
  /// the same user was explicitly confirmed past a warning - either the
  /// employee confirming a cross-client overlap (self-service, no
  /// edit_others required - clients differ) or a manager/admin using the
  /// existing "אפשר חפיפה (override)" checkbox (edit_others, any client -
  /// same-client included). Same-client overlap for a non-privileged actor
  /// stays a hard, unconfirmable block exactly as before this feature.
  isOverlapConfirmed Boolean @default(false)

  /// Phase 14: APP for anything created through the web app, MCP for
  /// anything created through /api/mcp. See the EntryOrigin enum above.
  createdVia EntryOrigin @default(APP)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete only, per spec 6.1's "Audit שאסור לוותר עליו" box and the
  /// schema-header convention - never a hard DELETE via the app.
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  revisions TimeEntryRevision[]

  @@index([userId, startAt])
  @@index([clientId, startAt])
  @@index([categoryId, startAt])
  @@map("time_entries")
}

/// Immutable audit trail for every TimeEntry mutation after creation.
/// Spec 6.1's "Audit שאסור לוותר עליו" box: must snapshot before/after,
/// who, when, and (for admin-on-behalf-of-another-user edits) why. Never
/// updated or deleted - version is a simple 1,2,3... counter per entry.
model TimeEntryRevision {
  id          String   @id @default(cuid())
  timeEntryId String
  version     Int
  changedById String?
  changedAt   DateTime @default(now())
  beforeJson  Json?
  afterJson   Json?
  reason      String?

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("TimeEntryRevisionActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([timeEntryId, version])
  @@map("time_entry_revisions")
}

// --- Phase 3: Billing policy + hour bank + live client snapshot ----------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 3"):
// only BillingPolicy, HourBank, HourBankAdjustment are modeled here.
// AlertRule/AlertEvent (Phase 4), ReportSchedule/EmailDelivery (Phase 5/6),
// IntegrationConnection/ExternalMapping (Phase 8) remain out of scope.
//
// billableSeconds on TimeEntry (added in Phase 2) is now actually allowed
// to diverge from actualSeconds via BillingPolicy (spec section 7). A
// client with NO BillingPolicy row keeps the exact Phase 2 behavior
// (billable = actual, unmodified) - backward compatibility per the
// engagement's own standing instruction. See lib/app-domain/billing.ts.

/// Spec 7.1's own example table, used verbatim.
enum RoundingMode {
  CEIL
  NEAREST
  EXACT
}

/// Spec 7.1: "Aggregation scope: per entry / per task per day / per day."
enum BillingAggregationScope {
  PER_ENTRY
  PER_TASK_PER_DAY
  PER_DAY
}

/// Spec 8.2: "Rollover configurable: none / full / capped / manual."
enum RolloverMode {
  NONE
  FULL
  CAPPED
  MANUAL
}

/// 12.10.2026 (RIMED): see HourBank.kind.
enum HourBankKind {
  CYCLE
  PREPAID
}

/// Spec 8.2: a cycle is normally OPEN (current), becomes CLOSED once
/// cycle_end passes, and flips to RECALCULATED if a backdated edit lands
/// inside an already-CLOSED cycle's date range ("המערכת מחשבת מחדש
/// ומסמנת את ה-cycle כ-recalculated; אין לשנות silently דוח שכבר הופק
/// ללא log").
enum HourBankStatus {
  OPEN
  CLOSED
  RECALCULATED
}

/// Spec section 5's field list, verbatim: client_id, minimum_minutes,
/// increment_minutes, rounding_mode, applies_per_entry/per-task/per-day.
/// One row per client (spec 7.1: "Client override: כן"); a client with no
/// row here uses the neutral, no-op default (minimum 0, increment 1
/// minute, rounding EXACT, per-entry) - i.e. billable stays identical to
/// actual, exactly like every Phase 2 entry today. Spec 7.1's own
/// "Employee override: לא, אלא Permission מיוחד" is intentionally NOT
/// modeled as a separate per-user override table in Phase 3 - no such
/// special permission exists yet, and adding the structure for a
/// not-yet-real permission would be the same speculative scope creep the
/// spec's own "לא להמציא" instruction (section 25) warns against.
model BillingPolicy {
  id               String                  @id @default(cuid())
  clientId         String                  @unique
  minimumMinutes   Int                     @default(0)
  incrementMinutes Int                     @default(1)
  roundingMode     RoundingMode            @default(EXACT)
  aggregationScope BillingAggregationScope @default(PER_ENTRY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("billing_policies")
}

/// Spec section 5 + 8.2. One row per client per cycle (monthly by
/// default per section 25, but cycle_start/cycle_end are explicit dates
/// so an irregular first/last cycle is representable). consumedMinutes is
/// a cached snapshot of live usage (spec 8.3's formula, recomputed by
/// lib/app-domain/hour-banks.ts on every read of "current" - never trusted
/// stale for the live view) so historical cycles retain a sensible value
/// once closed without re-scanning TimeEntry forever.
///
/// rolloverMode/rolloverCapMinutes are NOT in spec section 5's bare field
/// list, but section 8.2 requires "Rollover configurable: none / full /
/// capped / manual" per client/cycle and section 25 confirms "Rollover:
/// Configurable; enabled per client if contract says so" without
/// specifying where the mode itself lives. Storing it on the cycle that
/// PRODUCES the rollover (rather than inventing a separate
/// ClientBillingSettings entity the spec never mentions) is the smallest
/// addition that satisfies the requirement - documented here and in
/// docs/adr/0001's Phase 3 addendum as an explicit, deliberate choice for
/// an underspecified parameter, per this engagement's standing
/// "document decisions" instruction.
model HourBank {
  id       String @id @default(cuid())
  clientId String

  /// 12.10.2026 (RIMED): CYCLE is a fixed window that renews (the
  /// original model). PREPAID is a package of hours bought up front and
  /// used until it runs out; it stays open until the next package is
  /// loaded or it expires, and its whole balance, an overrun included,
  /// carries into the next one. See loadPrepaidPackage.
  kind HourBankKind @default(CYCLE)

  /// For a PREPAID package cycleEnd is the expiry (one year from purchase
  /// by default). Loading the next package moves it back to the moment of
  /// the load, so the two packages meet and no minute is counted twice or
  /// not at all.
  cycleStart DateTime
  cycleEnd   DateTime

  purchasedMinutes   Int
  rolloverInMinutes  Int @default(0)
  rolloverMode       RolloverMode @default(NONE)
  /// Only meaningful when rolloverMode = CAPPED.
  rolloverCapMinutes Int?

  /// Cached snapshot - spec 8.3's live formula, recomputed on read.
  consumedMinutes Int @default(0)

  status         HourBankStatus @default(OPEN)
  recalculatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adjustments HourBankAdjustment[]

  @@unique([clientId, cycleStart])
  @@index([clientId, cycleStart])
  @@map("hour_banks")
}

/// Spec section 5's field list, verbatim: client_id, minutes +/-, reason,
/// created_by, effective_at. hourBankId is an additional, optional
/// convenience FK (not in the spec's bare list) so the admin UI can
/// attach an adjustment to a specific cycle explicitly rather than only
/// inferring cycle membership from effective_at at read time - documented
/// here as a deliberate, minimal addition, same rationale as HourBank's
/// rollover fields above.
model HourBankAdjustment {
  id          String   @id @default(cuid())
  clientId    String
  hourBankId  String?
  /// Positive = credit added, negative = deduction. Spec 8.2: "manual
  /// adjustments."
  minutes     Int
  reason      String
  createdById String?
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hourBank  HourBank? @relation(fields: [hourBankId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("HourBankAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, effectiveAt])
  @@map("hour_bank_adjustments")
}

// --- Phase 4: Alerts + email delivery -------------------------------------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 4"):
// only AlertRule, AlertEvent, EmailDelivery are modeled here.
// ReportSchedule (Phase 5/6) and IntegrationConnection/ExternalMapping
// (Phase 8) remain out of scope.

/// Spec 9.1's threshold table. Forecast is explicitly marked "Future" in
/// the spec itself, so only the other four rows are modeled - not an
/// oversight, see ADR 11.3.
enum AlertThresholdType {
  UTILIZATION_PCT
  REMAINING_MINUTES
  CONSUMED_MINUTES
  OVERAGE
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

/// Spec section 5 + 9.1. One row per (client, threshold definition).
/// recipientsAnkora/recipientsClient are plain email-address arrays -
/// spec 9.1: "כל Rule כולל recipients נפרדים ל-Ankora וללקוח" - no
/// per-recipient entity is warranted for what is just a short address
/// list per rule (ADR 11.3).
model AlertRule {
  id       String             @id @default(cuid())
  clientId String
  type     AlertThresholdType

  /// Meaning depends on `type`: percentage points for UTILIZATION_PCT
  /// (e.g. 80 = 80%), minutes for REMAINING_MINUTES/CONSUMED_MINUTES,
  /// ignored (0) for OVERAGE - spec 9.1's own examples ("Remaining hours
  /// <= 5") are always expressed here as minutes, never float hours, per
  /// section 25's storage convention.
  thresholdValue Int @default(0)

  recipientsAnkora String[]
  recipientsClient String[]

  enabled Boolean @default(true)

  /// Spec 9.2's own field name, used verbatim: "אלא אם
  /// rule.allow_retrigger=true."
  allowRetrigger Boolean @default(false)

  /// 9.10.2026: also mail the client's account manager (Client.accountManagerId),
  /// resolved when the alert fires rather than copied into recipientsAnkora,
  /// so a change of account manager is followed without editing rules. On for
  /// the default rules (DEFAULT_ALERT_RULES in lib/app-domain/alerts.ts).
  notifyAccountManager Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([clientId, enabled])
  @@map("alert_rules")
}

/// Spec section 5 + 9.2. One row per time a rule actually fires.
/// resolvedAt implements the crossing/dedupe logic documented in ADR
/// 11.3 - null means "still above threshold since it fired", set once
/// utilization drops back below the threshold.
model AlertEvent {
  id         String   @id @default(cuid())
  ruleId     String
  hourBankId String
  triggeredAt DateTime @default(now())
  /// The raw metric value (minutes or percentage points, matching the
  /// rule's own `type`) at the moment this event fired - spec 5's "value"
  /// field, verbatim.
  value      Int
  resolvedAt DateTime?

  rule           AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([ruleId, hourBankId])
  @@map("alert_events")
}

/// Spec section 5's field list, verbatim: template, recipients,
/// provider_message_id, status, attempts, error. One row per logical
/// send action (Ankora recipients / client recipients are two separate
/// rows when a rule has both) - see ADR 11.3.
model EmailDelivery {
  id               String              @id @default(cuid())
  alertEventId     String?
  /// Phase 6 addition: set when this send is a scheduled client/internal
  /// report (spec 15) rather than a Phase 4 alert. A row has exactly one
  /// of alertEventId/reportRunId set in practice - not enforced as a DB
  /// CHECK constraint (Prisma has no portable way to express XOR across
  /// nullable FKs), but every write path only ever sets one of the two.
  reportRunId      String?
  template         String
  recipients       String[]
  /// 7.10.2026: the exact subject and text that were sent, so a retry
  /// resends the real message instead of a stub. Null on rows written
  /// before that date, and on the nightly backup (its attachments are not
  /// stored, so it is never retried; the next night produces a new one).
  subject          String?
  body             String?
  providerMessageId String?
  status           EmailDeliveryStatus
  attempts         Int                 @default(1)
  lastAttemptAt    DateTime            @default(now())
  error            String?
  createdAt        DateTime            @default(now())

  alertEvent AlertEvent? @relation(fields: [alertEventId], references: [id], onDelete: SetNull)
  reportRun  ReportRun?  @relation(fields: [reportRunId], references: [id], onDelete: SetNull)

  @@index([status, attempts])
  @@map("email_deliveries")
}
// --- Phase 6: Client portal + scheduled reports ---------------------------
//
// Scope discipline (spec section 23 / docs/adr/0001 addendum "Phase 6"):
// ReportSchedule + ReportRun are modeled here, per spec section 5's own
// field list for ReportSchedule ("client_id, report_type, frequency,
// recipients, timezone, enabled") plus the scheduling fields (dayOfWeek/
// dayOfMonth/hour) spec 15 requires but doesn't name explicitly ("Weekly
// report: ברירת מחדל configurable... Monthly report: ...ביום מוגדר").
// ReportRun is the "Snapshot/Report run id" spec 15 explicitly calls for
// ("לפני שליחה ליצור Snapshot/Report run id כדי שיהיה ניתן לדעת בדיוק מה
// נשלח") - one row per period actually sent, with the exact rendered
// report frozen as JSON, and a unique (scheduleId, periodStart) constraint
// that makes re-running the cron for an already-sent period a no-op
// rather than a duplicate send (spec 18.2's idempotency principle, applied
// here to scheduled sends instead of timer start/stop).
//
// ClientReportType is deliberately a 4-way subset of spec 14.1's 5-report
// client table: Monthly Detailed, Weekly Activity, Hours by Category, and
// Hour Bank Status. "Trend" is spec 14.1's own row explicitly marked
// "אופציונלי MVP+" - same exclusion precedent as Phase 4's AlertRule
// leaving out the spec-marked-Future "Forecast" threshold type.

enum ReportFrequency {
  WEEKLY
  MONTHLY
}

enum ClientReportType {
  MONTHLY_DETAILED
  WEEKLY_ACTIVITY
  HOURS_BY_CATEGORY
  HOUR_BANK_STATUS
}

/// Spec section 5 + 15. One row per (client, report type, cadence) an
/// Ankora admin has configured to auto-send. dayOfWeek (0=Sunday..
/// 6=Saturday) is read only when frequency=WEEKLY; dayOfMonth (1-28,
/// capped below 29 so every month has that day - spec never asks for
/// "last day of month" semantics) only when frequency=MONTHLY. `hour` is
/// the local hour (0-23, in `timezone`) the cron treats as this
/// schedule's due time - see lib/app-domain/report-schedules.ts's
/// isScheduleDue for the actual due-calculation, kept as a pure,
/// independently unit-tested function.
model ReportSchedule {
  id       String           @id @default(cuid())
  clientId String
  reportType ClientReportType
  frequency  ReportFrequency

  recipients String[]
  timezone   String   @default("Asia/Jerusalem")

  dayOfWeek  Int? // 0-6, WEEKLY only
  dayOfMonth Int? // 1-28, MONTHLY only
  hour       Int  @default(7)

  enabled    Boolean   @default(true)
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runs   ReportRun[]

  @@index([clientId, enabled])
  @@map("report_schedules")
}

/// The "Snapshot/Report run id" spec 15 requires. snapshotJson freezes
/// the exact rendered report (same shape as the portal screen that
/// produced it) at send time, independent of whatever the underlying
/// TimeEntry/HourBank rows look like later - so "what did we actually
/// send on that date" is always answerable even after subsequent edits
/// or a RECALCULATED cycle (spec 8.2's own "אין לשנות silently דוח שכבר
/// הופק ללא log" principle, applied to scheduled reports too).
model ReportRun {
  id          String   @id @default(cuid())
  scheduleId  String
  periodStart DateTime
  periodEnd   DateTime
  snapshotJson Json
  createdAt   DateTime @default(now())

  schedule        ReportSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@unique([scheduleId, periodStart])
  @@map("report_runs")
}

// --- Phase 8: Integration foundation validation + production rollout ----
//
// Spec section 23 scopes Phase 8 to "Integration foundation validation +
// production rollout" - the Epic table (section 22) names it explicitly:
// "generic tables/interfaces + no ClickUp coupling in domain." These two
// models are exactly spec section 5's own field list for them - no more,
// since 17.3 is explicit that Ankora can already show a placeholder
// "Integrations" admin screen without requesting any OAuth scope until
// the actual ClickUp integration is built. Task.source/externalRef
// (Phase 2) already exist for the eventual per-entity mapping; these two
// tables are the system-level connection record and the generic mapping
// table spec 17.1/17.2 describe for whenever that build happens.

/// Spec section 5: "IntegrationConnection - provider, status,
/// credentials_ref, config." One row per external provider (e.g.
/// "clickup") - not per-client, since spec 17.2's per-client Workspace/
/// Space/Folder/List mapping is future config that would live inside
/// `config` (Json) once built, not a new column now. `credentialsRef` is
/// deliberately a String, never the credential itself: spec 17.2 "Credentials
/// נשמרים secret/encrypted store, לא בטבלת plain text" - this column only
/// ever holds an opaque pointer into that external store (e.g. a Vercel/host
/// secret name), and nothing in this phase writes a real value into it,
/// since no OAuth flow exists yet (spec 17.3).
model IntegrationConnection {
  id            String               @id @default(cuid())
  provider      String               @unique
  status        IntegrationStatus    @default(NOT_CONNECTED)
  credentialsRef String?
  config        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings ExternalMapping[]

  @@map("integration_connections")
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// Spec section 5: "ExternalMapping - provider, internal_entity_type/id,
/// external_entity_type/id, sync metadata." Generic on purpose (spec
/// 17.1's Integration interface is provider-agnostic) - a Task-to-ClickUp-
/// task mapping is the first expected use per 17.2, but the shape is not
/// hardcoded to Task so a future Client-to-Workspace or Category-to-Folder
/// mapping does not need a new table. `syncMetadata` (Json) is deliberately
/// unopinionated: spec 17.2 requires idempotent webhook handling via
/// external event ids and leaves the exact bookkeeping fields
/// unspecified, so this stays a free-form bag rather than named columns
/// that would need a migration for every new provider's quirks. Unique on
/// (provider, internalEntityType, internalEntityId) - a given internal
/// entity can only be mapped once per provider - spec 17.2's own rule
/// ("לא להשתמש בשם המשימה כמפתח סנכרון") implies the internal id, not any
/// mutable field, is the stable half of the mapping.
model ExternalMapping {
  id                 String   @id @default(cuid())
  provider           String
  internalEntityType String
  internalEntityId   String
  externalEntityType String
  externalEntityId   String
  syncMetadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection IntegrationConnection @relation(fields: [provider], references: [provider], onDelete: Cascade)

  @@unique([provider, internalEntityType, internalEntityId])
  @@index([provider, externalEntityType, externalEntityId])
  @@map("external_mappings")
}

// --- Phase 9: gap-fix pass (spec re-audit, docs/adr/0001 section 17) ---

/// Spec section 11's "Notifications" screen ("חריגות/טיימר ארוך/alerts
/// פנימיים") - never modeled before this phase. Purely user-scoped (no
/// client/role scoping needed): every user only ever sees their own rows.
/// `type` is a free string rather than an enum on purpose, mirroring
/// AuditEvent.action's own precedent (docs/adr/0001) - new notification
/// kinds can be added without a schema migration.
model Notification {
  id       String  @id @default(cuid())
  userId   String
  type     String
  title    String
  body     String
  entityType String?
  entityId   String?
  readAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dedupes the long-running-timer notification (spec 6.1) so the daily
  // cron (see app/api/cron/alerts-reconcile) never sends a second email
  // for the same still-running TimeEntry - one notification row per
  // (type, entityId) pair is the dedupe key, checked before insert rather
  // than enforced by a DB constraint, since entityId is nullable for
  // notification types that aren't tied to one entity.
  @@index([userId, readAt])
  @@index([type, entityId])
  @@map("notifications")
}

// --- Phase 10: Important Dates ("מועדים חשובים") -------------------------
//
// Scope discipline: models ImportantDate, ReminderRule, ReminderOccurrence,
// HolidayCalendarSubscription, per the "מועדים חשובים" spec (HE, Sept
// 2026) - lets Ankora track per-client important dates (birthdays,
// document expiries, renewals, holidays, etc.), the reminders that fire
// before them, and the auto-created follow-up tasks. Reuses existing
// infrastructure end to end: Client/User/Task/Category, Notification,
// lib/email.ts, AuditEvent, soft delete, the daily reconciliation cron
// (app/api/cron/alerts-reconcile), and RBAC.
//
// Naming/modeling decisions where the spec is silent, documented once
// here rather than repeated on every field:
//
// - ImportantDate.type and HolidayCalendarSubscription.calendarKey are
//   plain Strings, not Postgres enums - the exact same precedent as
//   Notification.type/AuditEvent.action (see those models' own comments
//   above): the spec's own type catalog is large and the spec explicitly
//   wants it extensible without a migration ("אפשר למנהל להוסיף כותרת
//   מותאמת גם כאשר נבחר סוג קיים"). The canonical catalogs (label,
//   category, default recurrence, default reminders, holiday
//   definitions) live in code - lib/app-domain/important-dates-catalog.ts
//   and important-dates-holidays.ts - not the database.
// - relatedEntityType/relatedEntityName/relationToClient are flat
//   Strings, not a new normalized entity table (family member / vehicle /
//   property registry). The spec's own field list for ImportantDate asks
//   for exactly these flat fields ("סוג הישות שאליה המועד קשור", "שם
//   האדם או הפריט") - not a registry - and the "לא לפתח עכשיו" list
//   explicitly excludes OCR/document extraction, so nothing yet would
//   populate a normalized table beyond what these three strings capture.
// - Optimistic concurrency reuses the exact pattern already established
//   in Phase 7 (docs/adr/0001 section 14.7: an `updatedAt`-compare +
//   ConflictError, not a version-int column) - spec explicitly says "לפי
//   הדפוס הקיים."
// - ReminderRule.sendInApp/sendEmail are plain booleans rather than a
//   channel array - spec 9.1's own "ערוץ: התראה פנימית ו/או מייל" is
//   inherently a two-way choice, matching the codebase's existing
//   preference for booleans over enums on binary settings (e.g.
//   AlertRule.allowRetrigger).
// - ReminderOccurrence.idempotencyKey (spec: "מפתח Idempotency ייחודי") is
//   built from importantDateId + occurrenceYear + reminderRuleId +
//   recipient + channel (lib/app-domain/important-dates-reminders.ts's
//   buildIdempotencyKey) and carries the actual DB-level uniqueness
//   guarantee - the daily job's own pre-check is a friendlier early exit,
//   the same two-layer pattern TimeEntry's one-active-timer partial index
//   already uses (see that model's own header comment above).
// - Task gained assignedToId/dueDate/importantDateId/
//   importantDateOccurrenceKey as additive nullable columns (see that
//   model's own updated comment above) rather than a parallel task-like
//   entity - spec 25's "לא לבנות ארכיטקטורה מקבילה אם ניתן להרחיב רכיב
//   קיים" applied directly.

enum ImportantDateCategory {
  PEOPLE_FAMILY
  DOCUMENTS_AUTHORITIES
  BUSINESS_FINANCE
  VEHICLE_PROPERTY
  HEALTH_TRAVEL
  GENERAL
}

enum CalendarType {
  GREGORIAN
  HEBREW
}

enum RecurrenceType {
  ONCE
  ANNUAL
  MONTHLY
  CUSTOM_INTERVAL
  /// 13.10.2026 (org-brain spec 3.10): every week on `weekday`. "Every
  /// Thursday" is a weekday, and CUSTOM_INTERVAL of 7 days only matches it
  /// if somebody picked the right start date.
  WEEKLY
}

/// 13.10.2026 (org-brain spec 3.10). How well we know when a date falls.
/// A client file is full of "the 8th or the 9th" and "yearly, date
/// unknown". Forcing those into an exact day invents a fact; leaving them
/// out loses the obligation.
enum DatePrecision {
  EXACT
  /// One of `dayAlternatives`. Scheduled on the earliest, shown as all.
  APPROXIMATE
  /// Known to recur, day not known. Never scheduled; shown as a gap.
  UNKNOWN
}

/// 13.10.2026 (org-brain spec 3.10). How `autoTaskLeadDays` is counted.
/// "Three working days before the 10th" is not "three days before".
enum LeadUnit {
  CALENDAR_DAYS
  BUSINESS_DAYS
}

/// 13.10.2026 (org-brain spec 3.10). Where an occurrence that falls on a
/// non-business day moves: a payment due on a Saturday is made on the
/// Thursday before it.
enum RollConvention {
  NONE
  PREVIOUS_BUSINESS_DAY
  NEXT_BUSINESS_DAY
}

/// Spec's explicit status list, used verbatim: פעיל / דורש טיפול / בטיפול
/// / טופל למופע הנוכחי / הושהה / בארכיון.
enum ImportantDateStatus {
  ACTIVE
  NEEDS_ATTENTION
  IN_PROGRESS
  HANDLED_CURRENT
  PAUSED
  ARCHIVED
}

enum ImportantDateSensitivity {
  NORMAL
  SENSITIVE
}

/// Spec: "מקור המועד: ידני, חג או תבנית."
enum ImportantDateSource {
  MANUAL
  HOLIDAY
  TEMPLATE
}

enum ReminderChannel {
  IN_APP
  EMAIL
}

enum ReminderOccurrenceStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

/// Spec section "Important Date" - the core fact/event (not the reminder,
/// not the task - see the spec's explicit three-entity separation).
model ImportantDate {
  id       String @id @default(cuid())
  clientId String

  title    String
  /// Free-string catalog key - see schema-header comment above.
  type     String
  category ImportantDateCategory

  relatedEntityType String?
  relatedEntityName String?
  relationToClient  String?

  calendarType CalendarType @default(GREGORIAN)
  /// Gregorian: literal month (1-12)/day (1-31). Hebrew: Hebrew month
  /// number (1-13, Adar I/II both representable)/day (1-30). See
  /// lib/app-domain/important-dates-recurrence.ts for the conversion and
  /// every edge case (Feb 29, Adar I/II, variable Hebrew month lengths).
  month Int
  day   Int
  /// Optional origin year - spec: "שנה אופציונלית בימי הולדת וימי
  /// נישואים" / "הצגת גיל... רק אם שנת ההתחלה ידועה." Interpreted as a
  /// Gregorian year even when calendarType = HEBREW (the common case:
  /// someone knows they were born in 1990, not that they were born in
  /// 5750) - age/anniversary-years display always does a Gregorian-year
  /// subtraction from this field, never a Hebrew-year one.
  originYear Int?

  recurrence RecurrenceType @default(ANNUAL)
  /// Only meaningful when recurrence = CUSTOM_INTERVAL.
  customIntervalDays Int?
  /// Only meaningful when recurrence = WEEKLY: 0 = Sunday ... 6 = Saturday.
  weekday Int?
  /// Gregorian MONTHLY only: every N months, N in {1, 2, 3, 4, 6}, counted
  /// from `month`. Null is every month. Divisors of 12 only, so the cycle
  /// never needs an anchor year (lib/app-domain/important-dates-recurrence.ts).
  intervalMonths Int?
  /// How autoTaskLeadDays is counted. Default keeps every existing date's
  /// meaning.
  leadUnit LeadUnit @default(CALENDAR_DAYS)
  /// Where an occurrence on a non-business day moves. Applied to the
  /// occurrence itself, so reminders, the auto-task and the list all see
  /// the moved day.
  rollConvention RollConvention @default(NONE)
  /// Which business days: "IL" (Sunday to Thursday, Israeli rest days) or
  /// "US" (Monday to Friday, federal holidays). A free string, like `type`:
  /// a new calendar is an entry in lib/business-calendar.ts, never a
  /// migration. The org-brain spec makes the entity's country the default
  /// once entities exist; until then a person picks it.
  businessCalendar String @default("IL")
  /// How well the day is known. EXACT keeps every existing date's meaning.
  precision DatePrecision @default(EXACT)
  /// APPROXIMATE only: the possible days of the month ("8 or 9"). `day`
  /// holds the earliest, so scheduling errs early.
  dayAlternatives Int[] @default([])
  /// A date that applies only if something is true ("quarterly, only if
  /// the vulnerability SLA was missed"). Such a date never opens a task:
  /// the responsible person is asked whether the condition holds, because
  /// a task for work that may not exist is noise somebody learns to ignore.
  conditionText String?
  /// A recurrence that only runs inside a period (a SOC 2 cycle, 1.9.2026
  /// to 31.8.2027). Both optional; no occurrence falls outside them.
  rangeStart DateTime?
  rangeEnd   DateTime?
  /// Only meaningful when recurrence = ONCE - the exact one-time date;
  /// month/day/calendarType above are ignored for ONCE dates.
  onceDate DateTime?

  /// Feb 29 in a non-leap year: false (default, per spec) = Feb 28, true
  /// = Mar 1.
  leapDayUseMarchFirst Boolean @default(false)
  /// A Hebrew date recorded in Adar, observed during a 13-month Hebrew
  /// leap year: true (default, per spec) = Adar II, false = Adar I. Only
  /// consulted when calendarType = HEBREW and the recorded month is Adar.
  hebrewAdarTwoInLeapYear Boolean @default(true)

  timezone String @default("Asia/Jerusalem")

  responsibleUserId String
  /// Additional users who should see/be notified - a plain id list, same
  /// storage precedent as AlertRule.recipientsAnkora (String[], no join
  /// table, for what's just a short per-date list).
  additionalUserIds String[]
  extraEmailRecipients String[]

  status      ImportantDateStatus       @default(ACTIVE)
  sensitivity ImportantDateSensitivity  @default(NORMAL)
  notes       String?

  /// Portal phase 3. Opt-in per row, exactly like a task: a date Ankora
  /// tracks in order to act on it is not by itself something the client
  /// asked to have shown back to them.
  ///
  /// It is not the only gate. A SENSITIVE date is never shown in the
  /// portal whatever this says - that is enforced in the query rather
  /// than left to whoever ticks the box.
  clientVisible Boolean @default(false)

  createAutoTask     Boolean @default(false)
  autoTaskLeadDays   Int?
  autoTaskCategoryId String?

  /// Org brain, phase 1 (spec 3.10): the process this date starts. A
  /// process may have several dates (the 10th and the 25th).
  processId String?

  /// Cached, recomputed on every write and by the daily job - the next
  /// Gregorian date this important date falls on. Powers list/calendar
  /// sort and the dashboard/KPI cards without recomputing recurrence on
  /// every read.
  nextOccurrenceAt DateTime?
  /// The Gregorian anchor date of the CURRENT occurrence being tracked -
  /// once "today" passes this date, the daily job promotes the date to
  /// its next occurrence and resets status from HANDLED_CURRENT back to
  /// ACTIVE (spec: "לאחר מעבר למופע הבא, המועד חוזר למצב פעיל").
  currentOccurrenceAt DateTime?
  /// Snooze postpones reminders/handling without moving the event's own
  /// date (spec: "Snooze... לא לשנות את תאריך האירוע המקורי").
  snoozedUntil DateTime?

  source     ImportantDateSource @default(MANUAL)
  /// Set when source = HOLIDAY - which holiday-catalog key this row was
  /// generated from (important-dates-holidays.ts). Prevents re-creating
  /// the same holiday twice for a client even if it's reachable from two
  /// subscribed calendars (spec: "יש למנוע כפילות אם אותו חג מגיע משני
  /// לוחות").
  holidayKey String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser  User              @relation("ImportantDateResponsible", fields: [responsibleUserId], references: [id])
  createdBy        User?             @relation("ImportantDateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  autoTaskCategory Category?         @relation(fields: [autoTaskCategoryId], references: [id], onDelete: SetNull)
  process          Process?          @relation(fields: [processId], references: [id], onDelete: SetNull)
  reminderRules    ReminderRule[]
  occurrences      ReminderOccurrence[]
  tasks            Task[]

  @@unique([clientId, holidayKey])
  @@index([clientId, status, deletedAt])
  @@index([nextOccurrenceAt])
  @@index([responsibleUserId])
  // Portal phase 3: the client's file lists the dates opted in for them.
  @@index([clientId, clientVisible])
  @@map("important_dates")
}

/// Spec section "Reminder Rule" - how many days before, on which
/// channel(s), to whom.
model ReminderRule {
  id              String @id @default(cuid())
  importantDateId String

  daysBefore Int

  sendInApp Boolean @default(true)
  sendEmail Boolean @default(false)

  /// Extra Ankora-side recipients beyond the date's own
  /// responsible/additional users - same storage precedent as
  /// AlertRule.recipientsAnkora.
  extraAnkoraRecipients String[]
  /// Client-side recipients - stored per spec's own field list, but no
  /// write path sends to these yet in this MVP (client portal editing of
  /// dates is explicitly out of scope - see the spec's "לא לפתח עכשיו"
  /// list); keeping the column now avoids a migration if that changes.
  clientRecipients String[]

  enabled    Boolean @default(true)
  createTask Boolean @default(false)

  escalateToManager Boolean @default(false)
  escalateAfterDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importantDate ImportantDate        @relation(fields: [importantDateId], references: [id], onDelete: Cascade)
  occurrences   ReminderOccurrence[]

  @@index([importantDateId, enabled])
  @@map("reminder_rules")
}

/// Spec section "Reminder Occurrence / Delivery" - full send history, one
/// row per (date, occurrence year, rule, recipient, channel).
model ReminderOccurrence {
  id              String  @id @default(cuid())
  importantDateId String
  reminderRuleId  String?

  /// The Gregorian year of the specific ImportantDate occurrence this
  /// reminder belongs to - half of the idempotency key (spec: "המועד
  /// והמופע השנתי שאליהם ההתראה שייכת").
  occurrenceYear Int
  /// The anchor Gregorian date of that occurrence - stored directly (not
  /// only derived) so history stays readable even if the ImportantDate's
  /// own recurrence fields are edited later.
  occurrenceDate DateTime

  channel ReminderChannel

  recipientUserId String?
  recipientEmail  String?

  scheduledFor DateTime
  attemptedAt  DateTime?
  sentAt       DateTime?

  status   ReminderOccurrenceStatus @default(PENDING)
  error    String?
  attempts Int                      @default(0)

  providerMessageId String?

  /// The dedupe key itself (spec: "מפתח Idempotency ייחודי") - see
  /// lib/app-domain/important-dates-reminders.ts's buildIdempotencyKey.
  /// The unique constraint below is the real safety net; the daily job's
  /// own findFirst pre-check is only a friendlier early exit.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  importantDate ImportantDate @relation(fields: [importantDateId], references: [id], onDelete: Cascade)
  reminderRule  ReminderRule? @relation(fields: [reminderRuleId], references: [id], onDelete: SetNull)

  @@index([importantDateId, occurrenceYear])
  @@index([status, scheduledFor])
  @@map("reminder_occurrences")
}

/// Spec section "Holiday Calendar Subscription" - which holiday sets a
/// client is registered to; per-client, opt-in (spec: "אין להוסיף
/// אוטומטית את כל החגים לכל לקוח").
model HolidayCalendarSubscription {
  id       String @id @default(cuid())
  clientId String

  /// Which holiday set - a code-defined key (see
  /// lib/app-domain/important-dates-holidays.ts's HOLIDAY_CATALOG /
  /// HOLIDAY_CALENDAR_LABELS: currently "il_holidays" and
  /// "international_holidays") - a free String, not a DB enum, for the
  /// identical extensibility reason as ImportantDate.type: a new calendar
  /// is a catalog entry, never a migration.
  calendarKey String

  enabled Boolean @default(true)

  defaultReminderDaysBefore Int[]   @default([30, 7])
  responsibleUserId         String?
  createTasks                Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser User?  @relation("HolidaySubscriptionResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, calendarKey])
  @@map("holiday_calendar_subscriptions")
}

/// Portal phase 2: the one thing a client does in the portal.
///
/// Today these are decided in WhatsApp, between other messages: the
/// options scroll away, the answer is a thumbs-up on a message three
/// screens up, and nobody can say later who approved what. A decision is
/// that same conversation with a shape - a question, the options with
/// their prices, our recommendation, and a recorded answer.
///
/// It is also the service agreement's "approval in writing" for spending
/// above the client's ceiling, which is why the response below stores a
/// snapshot rather than a pointer: what the client agreed to must stay
/// readable even if the option text is later edited.
model Decision {
  id         String  @id @default(cuid())
  clientId   String
  /// The promise this decision blocks, when there is one. Optional: some
  /// decisions arrive before any task exists ("which of these three?").
  taskId     String?
  question   String
  background String?
  /// Agorot. The amount at stake, when the decision is about money. Null
  /// for decisions that are not (a date, a supplier, a preference).
  amountMinor Int?
  /// Copied from the client at creation, so a later change to the agreed
  /// ceiling never rewrites what an old approval said it was.
  ceilingMinorAtCreation Int?
  dueAt      DateTime?
  status     DecisionStatus @default(OPEN)
  createdById String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cancelledAt DateTime?

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User              @relation("DecisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  options   DecisionOption[]
  response  DecisionResponse?

  @@index([clientId, status])
  @@map("decisions")
}

enum DecisionStatus {
  OPEN
  ANSWERED
  /// Withdrawn by Ankora - the question stopped being relevant before the
  /// client answered it. Kept rather than deleted: a client who saw a
  /// decision appear and then vanish deserves the record that it did.
  CANCELLED
}

/// One of the two or three ways a decision can go. Rows rather than a
/// JSON column so an answer can point at one with a foreign key, and so
/// "which option did clients pick most" stays a query rather than a
/// migration.
model DecisionOption {
  id          String  @id @default(cuid())
  decisionId  String
  label       String
  detail      String?
  /// Agorot, when this particular option has its own price.
  amountMinor Int?
  /// Ankora's recommendation. At most one per decision - enforced in the
  /// domain layer (lib/app-domain/decisions.ts), not by a constraint,
  /// because "at most one true per group" has no clean expression here.
  recommended Boolean @default(false)
  position    Int     @default(0)

  decision  Decision           @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  responses DecisionResponse[]

  @@index([decisionId])
  @@map("decision_options")
}

/// The answer, and the evidence.
///
/// One per decision (the unique on decisionId), written once and never
/// updated: a client who changes their mind gets a new decision, so the
/// record of what they approved and when stays a record.
model DecisionResponse {
  id            String   @id @default(cuid())
  decisionId    String   @unique
  optionId      String
  respondedById String
  respondedAt   DateTime @default(now())

  /// The snapshot. The question and the chosen option as they read at the
  /// moment of approval, plus the amount agreed - so the proof does not
  /// depend on rows that can still change.
  questionSnapshot    String
  optionLabelSnapshot String
  amountMinorSnapshot Int?

  decision    Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  option      DecisionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  respondedBy User           @relation("DecisionResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  @@index([respondedById])
  @@map("decision_responses")
}


// ---------------------------------------------------------------------------
// Portal phase 3: the client's file, and the monthly summary.
// ---------------------------------------------------------------------------

/// How a supplier worked out, recorded on the task that used them.
///
/// Three values, not five stars. Whoever fills this in is closing a task,
/// not writing a review, and the only question the client ever asks of it
/// is whether we would use them again.
enum SupplierExperience {
  GOOD
  OK
  AVOID
}

/// How often a client wants the portal to reach them. Set by the client,
/// on their own screen.
enum PortalDigest {
  EVERY_DECISION
  WEEKLY
  MONTHLY
}

enum ClientDocumentKind {
  POLICY
  CERTIFICATE
  CONTRACT
  INVOICE
  OTHER
}

/// A document that belongs to the client, produced while working for
/// them: a policy, a confirmation, a signed contract.
///
/// The row holds a Drive file id and never a URL. Section 14's third rule
/// is that documents are reachable through this server only - a link that
/// works on its own outlives whatever permission granted it, and the
/// portal's whole isolation story is that access is decided per request
/// from the signed-in user, never from what someone happens to hold.
model ClientDocument {
  id       String  @id @default(cuid())
  clientId String
  /// The task this came out of, when it came out of one. Optional
  /// because a policy can arrive before anyone opened a task for it.
  taskId   String?

  title String
  kind  ClientDocumentKind @default(OTHER)

  driveFileId String
  mimeType    String
  sizeBytes   Int?

  /// Default true, unlike a task's. This table exists to hold the
  /// client's own documents - an internal draft has no business being
  /// filed here in the first place - so the honest default is that
  /// filing something means the client can have it. The toggle exists for
  /// the case where a document is prepared before it is ready to be seen.
  clientVisible Boolean @default(true)

  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task       Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy User?  @relation("ClientDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId, clientVisible])
  /// The manager's stalled-promises number asks this table "which of
  /// these tasks had something filed against them today", which is a
  /// lookup by taskId and nothing else. Without this it is a scan of
  /// every document in the product, on every dashboard load.
  @@index([taskId, createdAt])
  @@map("client_documents")
}

/// A short-lived address through which Claude moves a document's bytes
/// without passing them through the model (MCP, 12.10.2026).
///
/// Two purposes, one shape:
///   * "upload": start_document_upload. A bare PUT of the file to
///     /api/mcp/files/<ticket> files ONE document. Where it goes (client,
///     task, title, kind, visibility) is fixed here at issue time, through
///     the signed-in staff connector; the request brings only bytes.
///   * "download": read_document. A GET of the same address returns the
///     bytes of one existing document, for a Claude that reads the file in
///     its own environment (a scanned PDF, a spreadsheet).
///
/// No foreign keys, on purpose: every id is checked again at redemption
/// against the same access rules the screens use, so a person who lost a
/// client in those 15 minutes is refused then. Rows are short-lived and
/// harmless once used or expired.
model McpFileTicket {
  id        String @id @default(cuid())
  /// SHA-256 of the raw ticket. The raw value exists only in the tool result.
  tokenHash String @unique
  /// "upload" or "download".
  purpose   String
  userId    String
  /// User.tokenVersion when issued. "Log out everywhere" kills the address.
  tokenVersion Int @default(0)

  clientId   String
  /// Download: the document. Upload: the document it created, once used.
  documentId String?

  // Upload only.
  taskId        String?
  title         String?
  kind          ClientDocumentKind?
  fileName      String?
  /// Null when the model did not say; the upload's Content-Type, then the
  /// file name's extension, decide.
  mimeType      String?
  clientVisible Boolean             @default(false)

  expiresAt DateTime
  /// Upload: set atomically when a request claims the ticket, cleared again
  /// if that upload fails, so a network error does not burn the address.
  /// Download: the first fetch. A download may be repeated until it expires.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("mcp_file_tickets")
}

/// The monthly summary, as a record with a signature on it.
///
/// Two rules from the spec live in these columns rather than in a comment
/// somewhere:
///
/// Nothing generated reaches the client without a person approving it -
/// so the portal reads a summary only when `approvedById` is set, and an
/// unapproved one simply does not exist as far as the client is
/// concerned. If nobody approves it before the report goes out, the
/// report goes out without it.
///
/// And every sentence must trace back to a record. The ids the draft was
/// built from are captured with it, so the person approving it checks the
/// draft against the rows rather than against their memory of the month.
model PortalSummary {
  id       String @id @default(cuid())
  clientId String

  periodStart DateTime
  periodEnd   DateTime

  draft  String
  status PortalSummaryStatus @default(DRAFT)

  sourceTaskIds     String[]
  sourceDecisionIds String[]

  generatedAt  DateTime  @default(now())
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("PortalSummaryApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  /// One per client per period. Regenerating replaces the draft in place
  /// rather than leaving two summaries of the same month for someone to
  /// approve the wrong one of.
  @@unique([clientId, periodStart])
  @@index([clientId, status])
  @@map("portal_summaries")
}

enum PortalSummaryStatus {
  DRAFT
  APPROVED
  DISCARDED
}

/// Credentials vault (claude/credentials-vault-spec-2026-10-06.md).
///
/// A client's login to one of their own systems. The name and the link are
/// plain text: anyone assigned to the client sees them. Username, password
/// and notes live only inside `secretCiphertext`, as one AES-256-GCM
/// encrypted JSON document under a per-row data key (`wrappedDek`), which
/// is itself wrapped by the key-encryption key (VAULT_KEK, a sensitive
/// Vercel variable; Cloud KMS is supported but not configured). See
/// lib/vault/ for the scheme and lib/app-domain/credentials.ts for the
/// rules. Nothing outside the reveal route ever turns these bytes back
/// into text.
///
/// Deleting a credential nulls every secret column at once and keeps the
/// row, so the audit trail still has a name to point at.
model ClientCredential {
  id               String    @id
  clientId         String
  systemName       String
  url              String?
  secretCiphertext Bytes?
  secretIv         Bytes?
  secretTag        Bytes?
  wrappedDek       Bytes?
  /// Which key wrapped `wrappedDek`: "kms:<cryptoKeyVersion>" or
  /// "local:<fingerprint>". A row wrapped by one environment's key is
  /// refused, in words, by another's.
  kekRef           String?
  encVersion       Int       @default(1)
  /// Shown in the list so it can say "has a password" without decrypting.
  hasUsername      Boolean   @default(false)
  hasPassword      Boolean   @default(false)
  hasNotes         Boolean   @default(false)
  secretUpdatedAt  DateTime?
  lastRevealedAt   DateTime?
  lastRevealedById String?
  createdById      String
  updatedById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  client         Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User   @relation("CredentialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User   @relation("CredentialUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  lastRevealedBy User?  @relation("CredentialLastRevealer", fields: [lastRevealedById], references: [id], onDelete: SetNull)

  systems SystemAccess[]

  @@index([clientId, deletedAt])
  @@map("client_credentials")
}

/// "Verify it's you" before a reveal. One row per successful check, valid
/// for a few minutes. Bound to the user's tokenVersion, so changing the
/// password or "disconnect all sessions" closes every open window at once.
model StepUpGrant {
  id           String   @id @default(cuid())
  userId       String
  tokenVersion Int
  method       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("step_up_grants")
}

/// A passkey (Touch ID, Face ID, Windows Hello, a security key) that can
/// answer "verify it's you" before a credential is revealed
/// (claude/credentials-vault-spec-2026-10-06.md, phase 1a). Not a login
/// method: signing in to Ankora is unchanged.
///
/// Only the public half is stored. The private key never leaves the
/// person's device, so a database leak gives an attacker nothing to sign
/// with.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// The authenticator's credential id, base64url. What the browser
  /// sends back to say which passkey answered.
  credentialId String    @unique
  publicKey    Bytes
  /// The signature counter. A counter that goes backwards means a cloned
  /// authenticator, and is refused. Synced passkeys (iCloud) report 0.
  counter      Int       @default(0)
  transports   String[]
  /// What the person called it ("MacBook של אריאל").
  name         String
  deviceType   String
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// The half-finished sign-in between the first factor (password or
/// emailed link) and the passkey. No session exists until it completes:
/// the only provider Auth.js has accepts a pending login and nothing else.
/// Five minutes, single use, stored hashed (lib/app-auth/second-factor.ts).
model PendingLogin {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// "password" or "link": how the first factor was given.
  method     String
  /// Set when the sign-in may complete: at once when no second step was
  /// needed, or when the passkey answered (or a first one was enrolled).
  verifiedAt   DateTime?
  /// "none" or "passkey": which of the two set verifiedAt.
  secondFactor String?
  /// Set when a code from an already signed-in device was typed here:
  /// this sign-in may then enrol one more passkey (a new phone).
  deviceLinkedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_logins")
}

/// "Add a device" (17.10.2026): a six-digit code shown on a device that
/// is already signed in, after a passkey check there, and typed on the new
/// device right after its password. One live code per person, ten
/// minutes, five tries, single use. Stored as a hash bound to the person.
model DeviceLinkCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_link_codes")
}

/// One WebAuthn challenge, issued by the server and consumed once. Lives
/// for minutes. A challenge the server did not issue, or already used, is
/// refused, which is what stops a captured passkey answer from being
/// replayed.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String
  /// "register" or "step-up". A registration challenge cannot answer a
  /// step-up, and the reverse.
  purpose   String
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("webauthn_challenges")
}

// --- Marketing site: contact requests (11.10.2026) ------------------------
//
/// One row per contact request accepted by /api/contact, with how the
/// person reached the site (lib/attribution.ts).
///
/// Until 11.10.2026 a request existed only as an email to info@, without
/// any attribution, and nothing could say where a lead came from: see
/// claude/lead-attribution-gap-2026-10-11.md. The email is still sent and
/// is still the alert; this row is the record that can be counted.
///
/// Not linked to Client: a lead is a person who has not become a client,
/// and most never will. No soft delete either: a person who asks to be
/// forgotten is deleted (privacy policy section 10), not hidden.
model WebsiteLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name    String
  email   String
  phone   String?
  areas   String[]
  message String?
  company String?
  /// "he" or "en": which version of the site the form was sent from.
  locale  String?

  /// "source / medium" of the visit that sent the form, and of the first
  /// visit this browser recorded, in GA4's vocabulary (describeSource).
  source         String?
  firstSource    String?
  landingPage    String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  /// 1 for a first visit.
  visitNumber    Int?
  firstSeenAt    DateTime?
  visitStartedAt DateTime?
  /// To find the same person in GA4's User explorer.
  gaClientId     String?
  gaSessionId    String?

  /// From Vercel's IP geolocation headers.
  country    String?
  region     String?
  city       String?
  deviceType String?
  os         String?
  browser    String?
  userAgent  String?

  /// The full, server-sanitised attribution, pages of the visit included.
  attribution Json?

  /// PENDING until Resend answers, then SENT or FAILED. A FAILED row is a
  /// lead nobody was told about: the reason this table writes first.
  emailStatus String @default("PENDING")

  @@index([createdAt])
  @@index([email])
  @@map("website_leads")
}

// ---------------------------------------------------------------------------
// Org brain, phase 2: the client file's people and organizations
// (claude/org-brain-spec-2026-10-12.md, sections 3.1, 3.5, decisions 2, 8).
// ---------------------------------------------------------------------------

/// How much we trust a piece of client knowledge (spec 3.1). The order is
/// the order of strength: an item is as strong as its weakest field.
enum KnowledgeStatus {
  /// The client, or a supplier of theirs, said or showed it explicitly.
  CONFIRMED
  /// A garbled transcript, a loose phrasing, or an assumption of ours.
  UNCERTAIN
  /// Known to be needed, not received.
  MISSING
  /// Replaced by a newer item. The row stays: nothing is overwritten.
  SUPERSEDED
}

enum KnowledgeAudience {
  /// Everyone assigned to the client.
  ALL_STAFF
  /// The account manager, managers, and `audienceUserIds`.
  ACCOUNT_TEAM
  /// Only `audienceUserIds` (and managers).
  RESTRICTED
}

enum KnowledgeSensitivity {
  NORMAL
  /// Never leaves the product through MCP.
  SENSITIVE
}

enum KnowledgeImportance {
  NORMAL
  /// "Not critical" in Hadas's file: an open item nobody needs to chase.
  LOW
}

/// Who a person is to the client (spec 3.5).
enum ContactRelationship {
  CLIENT_STAFF
  /// A firm that runs part of the client's operation (Nextage).
  PROVIDER
  /// Lawyer, accountant, consultant.
  ADVISOR
  INVESTOR
  /// Everyday suppliers (the cleaner, Dell).
  SUPPLIER
  /// Ankora's own people on this client.
  ANKORA
}

/// An organization, once for all of Ankora (decision 8). Nextage can serve
/// several of our clients; its name and domain are written once, and what
/// it is to each client lives on ClientOrganization.
model Organization {
  id      String   @id @default(cuid())
  name    String
  /// Email domains, lower case, without "@". A partner's domain assigns a
  /// conversation to a client only together with another participant
  /// (spec 5.1), because the same firm may work for several clients.
  domains String[] @default([])
  website String?
  notes   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  people        Person[]
  clients       ClientOrganization[]
  clientDomains ClientDomain[]

  @@index([name])
  @@index([domains], type: Gin)
  @@map("organizations")
}

/// A person, once for all of Ankora (decision 8). Email and phone are
/// facts about the person and are shared: correcting Shani's address for
/// one client corrects it for every client she works with. Everything that
/// depends on the client (role, context, who may see it) is on
/// ClientContact, and never crosses from one client to another.
model Person {
  id             String   @id @default(cuid())
  /// Optional: "the cleaner" is a person whose name nobody wrote down
  /// (mapping gap 14). A ClientContact without a name carries a role.
  name           String?
  /// Lower case, trimmed (lib/contact-normalize.ts).
  emails         String[] @default([])
  /// E.164 where it could be inferred, digits and "+" otherwise.
  phones         String[] @default([])
  organizationId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contacts     ClientContact[]

  @@index([emails], type: Gin)
  @@index([phones], type: Gin)
  @@map("persons")
}

/// A person in one client's file (spec 3.5): who they are to this client
/// and what you need to know to work with them. Carries the knowledge
/// fields of spec 3.1, like every item in the client file.
model ClientContact {
  id       String @id @default(cuid())
  clientId String
  personId String

  role            String?
  relationship    ContactRelationship @default(CLIENT_STAFF)
  /// Which of the client's legal entities this person works with (Shani:
  /// Inc). Same client only.
  entityId        String?
  /// What you need to know to work with them. "פונים אליה בכל ספק של Inc."
  context         String?
  /// Channels in order of preference: ["WhatsApp", "Slack", "מייל"].
  channelOrder    String[] @default([])
  isPrimary       Boolean  @default(false)
  isDecisionMaker Boolean  @default(false)
  /// Ankora people only: the user, and the address they use on the
  /// client's side (Hadas, office@nux.ai).
  userId            String?
  clientSideAddress String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  /// { "<field>": { "status": "MISSING" | "UNCERTAIN", "toResolve"?: string, "sources"?: [...] } }
  fieldStatus     Json                 @default("{}")
  /// [{ "code": "S11", "at": "05:02" }] once the source register exists.
  sources         Json                 @default("[]")
  /// [{ "system": "RAID", "id": "RAID-002" }]
  externalRefs    Json                 @default("[]")
  /// Conflicting versions, each with a value and a source.
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  /// Plain ids, no foreign key, like the audit trail: an owner who leaves
  /// must not take the item with them.
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  entity ClientEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([clientId, personId])
  @@index([clientId, deletedAt])
  @@map("client_contacts")
}

/// An organization in one client's file: what it does for them and what it
/// costs (decision 2). Replaces the VENDOR fact of spec v2, so Nextage is
/// stored once, as an organization, and linked.
model ClientOrganization {
  id             String @id @default(cuid())
  clientId       String
  organizationId String

  /// What they are to this client: "הנהלת חשבונות ושכר", "נאמן אופציות".
  role             String?
  relationship     ContactRelationship @default(PROVIDER)
  /// Agorot (or cents), with the currency, when a recurring cost is known.
  monthlyCostMinor Int?
  currency         String?
  notes            String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([clientId, organizationId])
  @@index([clientId, deletedAt])
  @@map("client_organizations")
}

/// What a source is (spec 3.2).
enum SourceKind {
  /// A recorded meeting. One source may be several recordings of the
  /// same meeting.
  TRANSCRIPT
  /// A document of the client's, or of a supplier of theirs.
  CLIENT_DOCUMENT
  TASK
  /// Somebody told us, outside a recording.
  PERSON
  /// A document Ankora wrote (Hadas's KI, HMP, TE).
  ANKORA_DOCUMENT
}

enum SourceWeight {
  /// The client or a supplier of theirs.
  PRIMARY
  /// Ankora's own writing. An item whose sources are all secondary is
  /// never "confirmed" (rule R14).
  SECONDARY
}

enum SourceRestriction {
  NONE
  /// Topics only: no quotes, no details (a NUX board meeting).
  TOPICS_ONLY
}

/// The client's source register (spec 3.2): S1, S2... per client, in the
/// order they were added. Every item in the file points here.
model ClientSource {
  id       String @id @default(cuid())
  clientId String
  /// 1, 2, 3... per client. `code` is "S" + seq, stored so a reader never
  /// has to compute it.
  seq      Int
  code     String

  kind         SourceKind
  weight       SourceWeight      @default(PRIMARY)
  title        String
  /// The day, stored as UTC midnight like every other date-only field.
  occurredAt   DateTime?
  participants String[]          @default([])
  /// [{ "system": "FIREFLIES" | "DOCUMENT" | "TASK" | "OTHER", "id": "..." }]
  externalRefs Json              @default("[]")
  restriction  SourceRestriction @default(NONE)
  notes        String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, seq])
  @@unique([clientId, code])
  @@map("client_sources")
}

enum ClientDomainKind {
  /// The client's own (nux.ai).
  CLIENT
  /// A partner's (nextage.co.il). May appear in several clients' files.
  PARTNER
}

/// Email domains that belong to a client's world (spec 3.5). Lets mail
/// and recordings be matched to the right client.
model ClientDomain {
  id             String           @id @default(cuid())
  clientId       String
  domain         String
  kind           ClientDomainKind
  /// For a partner domain: whose it is.
  organizationId String?
  notes          String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([clientId, domain])
  @@index([domain])
  @@map("client_domains")
}

/// What Ankora may do in a client's system (spec 3.6).
enum SystemPermission {
  NONE
  VIEWER
  USER
  BILLING
  ADMIN
  OWNER
}

enum SystemAccessStatus {
  HAS_ACCESS
  /// Asked for, not granted yet.
  PENDING
  NO_ACCESS
  /// The client keeps it; we do not need in.
  NOT_NEEDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  OTHER
}

/// The client's system map (spec 3.6, section 7.1 of Hadas's file). The
/// vault holds secrets; this holds everything else about a system,
/// including systems we have no access to. Every system that is not
/// HAS_ACCESS or NOT_NEEDED is a handover gap, with no separate list to
/// keep.
model SystemAccess {
  id       String @id @default(cuid())
  clientId String

  systemName    String
  purpose       String?
  /// Which of the client's legal entities it belongs to (Mercury: Inc).
  entityId      String?
  url           String?
  /// The account we use: "office@nux.ai", or "the CEO's private mail".
  accountUsed   String?
  ourPermission SystemPermission   @default(NONE)
  accessStatus  SystemAccessStatus @default(NO_ACCESS)
  /// What is in the way: "MFA on the CEO's phone".
  blocker       String?
  /// Who manages it on the client's side.
  clientAdmin   String?
  /// The vault entry, when there is one. Same client only.
  credentialId  String?

  // A SaaS bill, kept with the system so the supplier is stored once.
  billingCycle     BillingCycle?
  billingCostMinor Int?
  billingCurrency  String?
  /// Last four digits of the card it is charged to. Never more.
  cardLast4        String?
  /// Where the invoice arrives: "billing-us@nux.ai".
  invoiceTo        String?
  notes            String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credential ClientCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  entity     ClientEntity?     @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([clientId, deletedAt])
  @@map("system_access")
}

/// What a fact in the client file is (spec 3.4). Each kind is a section of
/// Hadas's file.
enum FactKind {
  /// In scope for Ankora (section 2).
  SCOPE_IN
  /// Out of scope, and who handles it instead (section 2).
  SCOPE_OUT
  /// A preference, of the client or of one of their people (section 4).
  PREFERENCE
  /// A standing requirement of the client (section 5).
  REQUIREMENT
  /// Where knowledge lives: a drive, a channel, a mailbox (section 7.3).
  LOCATION
  /// A financial fact: a transfer limit, a payroll day (section 8).
  FINANCE
  /// True for now, with an end: a date or an event (section 11).
  TEMPORARY
  /// A decision taken once, with when and by whom (section 12).
  ONE_OFF_DECISION
  /// An open question, with who chases it (section 13).
  QUESTION
  NOTE
}

enum FactTopic {
  COMMUNICATION
  REPORTING
  DOCUMENTS
  AUTOMATION
  ADMINS
  PAYMENTS
  SUPPLIERS
  OTHER
}

/// Everything in the client file without a structure of its own
/// (spec 3.4). A changed fact is never edited in place: the new one is
/// added and the old one is marked SUPERSEDED, pointing at it.
model ClientFact {
  id       String   @id @default(cuid())
  clientId String
  kind     FactKind
  topic    FactTopic?

  /// The fact itself, in a sentence or two.
  body             String
  /// Whose preference: a contact or an organization in this client's
  /// file. Neither means the client's own.
  subjectContactId String?
  subjectOrgId     String?
  /// SCOPE_OUT: who handles it instead ("Nextage", "H-F, Ankora
  /// coordinates").
  referTo          String?

  /// TEMPORARY: until a date, or until an event ("until the account joins
  /// the organization"). At least one.
  validUntil      DateTime?
  validUntilEvent String?
  /// A temporary fact found to be over. Kept, as history.
  closedAt        DateTime?

  /// ONE_OFF_DECISION: when, and who decided.
  decidedAt DateTime?
  decidedBy String?

  /// QUESTION: who chases it, and the answer once there is one.
  assigneeId String?
  answeredAt DateTime?
  answer     String?

  /// Work that came out of this fact: a question turned into a task, or
  /// the open issue behind a temporary fact.
  taskId String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, kind, deletedAt])
  @@map("client_facts")
}

/// A legal entity of the client (spec 3.3): NUX Inc and NUX.AI Ltd. Money
/// and people are attached to an entity, because paying Inc's invoice from
/// Ltd is the kind of mistake the file exists to prevent.
model ClientEntity {
  id       String @id @default(cuid())
  clientId String

  /// Short, as people say it: "Inc", "LTD".
  name               String
  legalName          String?
  /// ח.פ., EIN, or whatever the country uses.
  registrationNumber String?
  /// ISO 3166 alpha-2: "IL", "US".
  country            String?
  /// ISO 4217: "ILS", "USD".
  currency           String?
  billingAddress     String?
  /// The parent, for a subsidiary (Ltd is Inc's).
  parentId           String?

  // Knowledge fields (spec 3.1). fieldStatus matters most here: an entity
  // can be confirmed while its registration number is still missing.
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parent       ClientEntity?   @relation("EntityParent", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries ClientEntity[]  @relation("EntityParent")
  contacts     ClientContact[]
  systems      SystemAccess[]
  requestTypes RequestType[]

  @@index([clientId, deletedAt])
  @@map("client_entities")
}

/// Where a batch of proposals came from (spec 5.1).
/// Spec 3.3.
enum ClientKind {
  BUSINESS
  PRIVATE
}

enum KnowledgeBatchVia {
  /// propose_knowledge, from Claude.
  MCP
  SCREEN
}

enum ProposalTarget {
  FACT
  CONTACT
  ORGANIZATION
  SYSTEM
  REQUEST_TYPE
  POLICY
  ENTITY
  NARRATIVE
  PROCESS
  DOMAIN
}

/// What approving a proposal does.
enum ProposalAction {
  /// A new item in the file.
  CREATE
  /// A new version of an existing fact; the old one is kept as superseded.
  SUPERSEDE
  /// A contradiction of an existing fact. Nothing is overwritten: the
  /// claim joins the fact's alternatives, and the fact becomes uncertain.
  CONTRADICT
}

enum ProposalState {
  PENDING
  APPROVED
  REJECTED
}

/// One delivery of proposals: usually one meeting or one document (spec
/// 5.1, 5.2). Shown as one card in "ממתין לאישור".
model KnowledgeBatch {
  id       String            @id @default(cuid())
  clientId String
  /// The source in the client's register. Created, or found by its
  /// recording, when the batch arrives.
  sourceId String?
  via      KnowledgeBatchVia @default(MCP)
  /// A line from whoever sent it: what was read, what was left out.
  note     String?
  /// Items that never became proposals, and why: secrets (never stored,
  /// only counted) and quotes from a topics-only source.
  dropped  Json              @default("[]")

  /// Spec 5.1, step 3: a meeting with a partner who serves several of
  /// Ankora's clients, with nobody on it who decides whose it is. Claude
  /// proposes `clientId` among `candidateClientIds`, with
  /// `assignmentReason`. The items wait in `pendingInput`: no proposal is
  /// made and no source registered in any file until a person picks the
  /// client. Then the batch is proposed to that client as if sent there,
  /// and this row is removed.
  awaitingAssignment Boolean  @default(false)
  candidateClientIds String[] @default([])
  assignmentReason   String?
  pendingInput       Json?

  createdById String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposals KnowledgeProposal[]

  @@index([clientId, closedAt])
  @@index([awaitingAssignment])
  @@map("knowledge_batches")
}

/// One proposed item (spec 5.2). Nothing reaches the file until a person
/// approves it on the screen (decision 1): there is no tool that approves.
model KnowledgeProposal {
  id       String         @id @default(cuid())
  batchId  String
  clientId String
  target   ProposalTarget
  action   ProposalAction @default(CREATE)
  /// For SUPERSEDE and CONTRADICT: the fact it is about.
  targetId String?
  /// The item as it would be written: the same fields the screens send.
  payload  Json
  /// Why Claude thinks so, in a sentence.
  reason   String?
  /// A short quote from the source, when the source allows quotes.
  quote    String?
  /// Rule flags found when the proposal arrived: [{ code, message }].
  flags    Json           @default("[]")

  state        ProposalState @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  /// Whether the person changed it before approving (decision 1 measures
  /// this: under 10% after a month opens approval in conversation).
  edited       Boolean       @default(false)
  /// The item approving it created or changed.
  resultId     String?

  createdAt DateTime @default(now())

  batch KnowledgeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([clientId, state])
  @@index([batchId])
  @@map("knowledge_proposals")
}

/// What comes in from whom, and how it is answered (spec 3.7, section 7.5
/// of Hadas's file): "an Inc invoice from a supplier, to billing-us,
/// forwarded to Shani and Jenan, not to Ayala". Probably the most useful
/// thing in the file for a new Operations Manager's first day.
model RequestType {
  id       String @id @default(cuid())
  clientId String

  title      String
  /// Supplier, employee, Nextage, a system.
  fromWho    String?
  /// billing-us, WhatsApp, Slack, office@.
  arrivesVia String?
  /// How it is answered and where it goes.
  handling   String
  /// Who it is routed to: contacts in this client's file.
  routeToContactIds String[] @default([])
  /// When it belongs to one entity (an Inc invoice).
  entityId   String?
  /// The process this kind of request sets off (spec 3.7): "an employee's
  /// trip" starts P6. Same client only.
  processId  String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entity ClientEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  process Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@index([clientId, deletedAt])
  @@map("request_types")
}

enum NarrativeKind {
  /// Who the client is, in a paragraph.
  OVERVIEW
  /// How we got here.
  BACKGROUND
  /// What Ankora does for them.
  OUR_ROLE
}

/// The file's free text (spec 3.3, section 2 of Hadas's file), versioned
/// like a task plan: every save is a new row, so nothing is overwritten
/// and any version can be read again.
model ClientNarrative {
  id       String        @id @default(cuid())
  clientId String
  kind     NarrativeKind
  version  Int
  /// Markdown, the product's small subset (lib/markdown-lite.ts). Source
  /// codes cited in it ("[S1 08:13]") must exist in the register.
  body     String

  createdById String?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, version])
  @@map("client_narratives")
}

enum GuideState {
  DRAFT
  APPROVED
  REJECTED
}

/// Ankora's guidance to Claude for extraction, in versions (decision 3).
/// What the server enforces stays in code; this is the part that guides:
/// what counts as relevant, what is left out, how to phrase. Anybody on
/// the team may propose a version; an admin approves it, and the latest
/// approved version is the one every extraction prompt carries.
model ExtractionGuide {
  id      String     @id @default(cuid())
  version Int        @unique
  body    String
  /// What changed, and why, in a line.
  note    String?
  state   GuideState @default(DRAFT)

  createdById  String?
  createdAt    DateTime  @default(now())
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?

  @@map("extraction_guides")
}

// ---------------------------------------------------------------------------
// Org brain, phase 3: the client's own rules
// (claude/org-brain-spec-2026-10-12.md, 3.11 and section 6 of the file).
// Ankora's own rules (the SOP book) stay in code; these are the client's.
// ---------------------------------------------------------------------------

/// What a client rule is about, and so where it is checked (spec 3.11).
/// Rules about procedure steps are kept now and enforced once processes
/// exist; rules about the file itself act today.
enum PolicyKind {
  /// What may enter the file and how: "board meetings, topics only".
  /// Given to every extraction.
  DATA_HANDLING
  /// Who must not be told what: "employees are not told Guy is leaving".
  /// Shown at the top of the client screen and the file.
  DISCLOSURE
  /// Which channel for what: "approvals by email, even if they began on WhatsApp".
  COMMUNICATION
  /// What must stay apart: "nothing of Inc goes to Ayala".
  SEPARATION
  APPROVAL_REQUIRED
  THRESHOLD
  REQUIRED_STEP
  TIMING
  /// Forbidden to everyone, not only to AI.
  FORBIDDEN
  /// Everything code cannot check: read by people and by Claude.
  INFO
}

enum PolicyStatus {
  /// Said, not approved. Its interim rule, when it has one, is what applies.
  PROPOSED
  /// Approved by a manager. The rule itself applies.
  ACTIVE
  /// No longer in force. Kept, as history.
  RETIRED
}

/// A rule the client set (spec 3.11). A change to what an approved rule
/// says sends it back to "proposed": a rule cannot be softened quietly.
model ClientPolicy {
  id       String       @id @default(cuid())
  clientId String
  kind     PolicyKind
  status   PolicyStatus @default(PROPOSED)
  /// 1 when written; +1 on every change to what it says.
  version  Int          @default(1)

  title            String
  /// The rule, in a sentence or two.
  statement        String
  /// Why it exists, when known.
  rationale        String?
  /// While proposed: the careful rule that applies until it is approved
  /// ("every expense goes to Oren" until "software up to $3,000 a year is
  /// approved" is).
  interimStatement String?
  /// What the server checks, when the rule says something it can check
  /// (lib/policy-params.ts): a threshold's amount, the tags it is about,
  /// the allowed channels. Empty: read by people and by Claude only.
  params           Json    @default("{}")
  /// The same for the interim rule, while proposed. Empty with an interim
  /// statement: a proposed threshold is read as zero.
  interimParams    Json    @default("{}")

  approvedById String?
  approvedAt   DateTime?
  retiredAt    DateTime?
  retiredById  String?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  ownerId         String?
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exceptions PolicyException[]

  @@index([clientId, deletedAt])
  @@map("client_policies")
}

enum PolicyExceptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// Taken back by whoever asked, before a decision.
  WITHDRAWN
}

/// A permitted deviation from one of the client's rules (spec 3.11, 7.2):
/// what deviates, why, until when, who asked and who approved. An
/// exception always ends: one with no end is a rule change, and is made
/// by changing the rule.
model PolicyException {
  id       String @id @default(cuid())
  clientId String
  policyId String

  /// What is done differently: "send this month's Inc invoices to Ayala".
  what       String
  reason     String
  /// The last day it holds, as UTC midnight like every date-only field.
  validUntil DateTime
  status     PolicyExceptionStatus @default(REQUESTED)

  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  /// Why it was refused, or a condition on the approval.
  decisionNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policy ClientPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([policyId])
  @@map("policy_exceptions")
}

// ---------------------------------------------------------------------------
// Org brain, phase 1: processes and their procedures
// (claude/org-brain-spec-2026-10-12.md, 3.8 and 3.9; reviewed by Hadas,
// 15.10.2026).
// ---------------------------------------------------------------------------

enum ProcessTrigger {
  /// By a date (ImportantDate.processId).
  SCHEDULED
  /// Something happens: a request, an employee's trip.
  EVENT
  /// Someone asks for it.
  ON_DEMAND
  /// Ongoing: no task per run, a periodic check instead.
  CONTINUOUS
}

enum ProcessStatus {
  /// Being written: no approved procedure yet.
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

/// Where the process stands in a handover (spec 3.8).
enum ProcessTransition {
  /// The client or a supplier of theirs runs it.
  WITH_CLIENT
  IN_HANDOVER
  WITH_ANKORA
  /// Not meant to move to us.
  NOT_PLANNED
}

/// How a step of a run is done (spec 3.9).
enum ProcessStepMode {
  MANUAL
  ASSISTED
  AUTOMATED
}

enum ProcessVersionStatus {
  DRAFT
  APPROVED
  /// An approved version a newer approved one replaced. Kept.
  SUPERSEDED
}

/// Something that recurs at a client, with an owner, a trigger and a
/// procedure (spec 3.8). The nine fields Oren asked for are what makes it
/// complete; each empty one is a gap that shows.
model Process {
  id       String @id @default(cuid())
  clientId String
  /// 1, 2, 3... per client; `code` is "P" + seq, as in Hadas's file.
  seq      Int
  code     String

  title   String
  /// Why it exists, in a sentence.
  purpose String?

  triggerKinds ProcessTrigger[] @default([])
  /// The trigger in words, always: "twice a month, on the 10th and 25th".
  triggerText  String?

  ownerId       String?
  backupOwnerId String?

  slaText         String?
  slaBusinessDays Int?

  /// Who outside the client takes part: contacts in this client's file,
  /// and the same in words when they are not in it ("Nextage", "none").
  externalPartyContactIds String[] @default([])
  externalPartyText       String?

  /// SystemAccess rows of this client the process needs.
  requiredSystemIds String[] @default([])

  /// Who approves: in words, and the contact when known.
  approverText      String?
  approverContactId String?
  /// Org brain (spec 5.3): who at Ankora signs an approval step of a run
  /// in the product. The step waits for them; the run does not close
  /// before they sign.
  approverUserId    String?
  /// The approval thresholds that apply: client rules, and the same in
  /// words ("new supplier: the accountant approves"; "none").
  approvalPolicyIds String[] @default([])
  approvalText      String?

  /// What to do when something deviates. Markdown.
  exceptionPlaybook String?

  entityId String?

  /// Who runs it today, in words ("Guy", "Nextage").
  executorText     String?
  transitionStatus ProcessTransition @default(WITH_CLIENT)

  status         ProcessStatus @default(DRAFT)
  categoryId     String?
  reviewEveryDays Int?
  lastReviewedAt DateTime?
  lastRunAt      DateTime?
  needsReview    Boolean       @default(false)
  /// Why it needs review (spec 7.3, 5.4): "RULES" when the approved
  /// procedure no longer passes the client's rules, "PERIODIC" when its
  /// review every `reviewEveryDays` fell due. Null when it does not.
  reviewReason   String?

  /// An ongoing process (CONTINUOUS) opens no tasks. It can have a check
  /// every N days instead ("once a week: no invoice is stuck"), which is
  /// what its owner sees in their routine (spec 3.8). Not the procedure's
  /// review (`reviewEveryDays`): that is about the document, this is about
  /// the work.
  checkEveryDays Int?
  checkText      String?
  lastCheckedAt  DateTime?

  // Knowledge fields (spec 3.1).
  knowledgeStatus KnowledgeStatus      @default(CONFIRMED)
  fieldStatus     Json                 @default("{}")
  sources         Json                 @default("[]")
  externalRefs    Json                 @default("[]")
  alternatives    Json                 @default("[]")
  toResolve       String?
  importance      KnowledgeImportance  @default(NORMAL)
  audience        KnowledgeAudience    @default(ALL_STAFF)
  audienceUserIds String[]             @default([])
  doNotDisclose   String?
  sensitivity     KnowledgeSensitivity @default(NORMAL)
  clientVisible   Boolean              @default(false)
  verifiedAt      DateTime?
  supersededById  String?
  supersededAt    DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions ProcessVersion[]
  lessons  ProcessLesson[]
  requestTypes RequestType[]
  dates    ImportantDate[]
  checks   ProcessCheck[]

  @@unique([clientId, seq])
  @@unique([clientId, code])
  @@index([clientId, deletedAt])
  @@map("processes")
}

/// One version of a process's procedure (spec 3.9). Never edited in
/// place: a change is a new row saved against the version it started
/// from, like a task plan. A manager approves; the checks that block
/// (R1 to R4) are run then.
enum ProcessCheckOutcome {
  OK
  ISSUE
}

/// One check of an ongoing process: who looked, what they found. An issue
/// says what, and opens a task for it.
/// What the person who closed a run says about the procedure it followed
/// (spec 5.4): "was anything in the procedure wrong or missing?". One
/// answer per run. "Nothing" is an answer too, recorded so the question
/// is not asked again. A lesson waits for the process's owner or a manager
/// to apply it in the next version, or to dismiss it.
model ProcessLesson {
  id        String              @id @default(cuid())
  processId String
  clientId  String
  /// The run. One answer per run.
  taskId    String              @unique
  /// The procedure version the run followed.
  version   Int?
  status    ProcessLessonStatus
  /// What was wrong or missing. Empty for NOTHING.
  body      String?
  authorId  String?
  createdAt DateTime            @default(now())

  resolvedById String?
  resolvedAt   DateTime?
  /// One line from whoever resolved it ("נכנס לגרסה 4").
  resolution   String?

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, status])
  @@map("process_lessons")
}

enum ProcessLessonStatus {
  /// "Nothing was wrong."
  NOTHING
  OPEN
  APPLIED
  DISMISSED
}

model ProcessCheck {
  id          String              @id @default(cuid())
  processId   String
  clientId    String
  checkedById String?
  outcome     ProcessCheckOutcome
  note        String?
  taskId      String?
  createdAt   DateTime            @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, createdAt])
  @@map("process_checks")
}

model ProcessVersion {
  id        String               @id @default(cuid())
  processId String
  version   Int
  status    ProcessVersionStatus @default(DRAFT)

  /// [{ title, mode: MANUAL | ASSISTED | AUTOMATED, offsetBusinessDays,
  ///    actionTags: [], systemIds: [], output, verification,
  ///    requiresApproval }], at most 15 (lib/process-rules.ts).
  steps      Json   @default("[]")
  /// Hadas's "דגשים": what matters and is not a step.
  highlights String?
  /// What must exist for a run to count as done.
  outputs    String?
  changeNote String?

  createdById  String?
  createdAt    DateTime  @default(now())
  approvedById String?
  approvedAt   DateTime?

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, version])
  @@map("process_versions")
}

// --- Employee agreements --------------------------------------------------
//
// Everyone at Ankora signs a confidentiality undertaking before they may
// use the app, and a deletion declaration when they leave. The point of
// recording a signature here, rather than only filing a PDF, is that the
// record says exactly which text was agreed to: the version, and a
// SHA-256 of the file that was on screen. A text that changes later gets
// a new version and a new file; the old file stays so every hash keeps
// resolving to the words it was taken over.

/// Which lifecycle task a Task is, when it is one. See Task.subjectUserId.
enum EmployeeLifecycleKind {
  ONBOARDING
  OFFBOARDING
}

enum AgreementKind {
  CONFIDENTIALITY
  DELETION_DECLARATION
}

/// How the signature was given. APP is the in-app form (a session, or a
/// one-time link for someone who has already left). EMAIL_PDF is a PDF
/// sent to the person and returned signed, recorded afterwards by an
/// admin; it exists from the start so the two channels never need a
/// migration to sit side by side.
enum AgreementChannel {
  APP
  EMAIL_PDF
}

/// One signature. Append-only: lib/app-domain/agreements.ts only ever
/// creates rows. A signature that turns out to be wrong is answered by a
/// new one, never by editing the old one, because the old one is evidence.
model EmployeeAgreement {
  id      String           @id @default(cuid())
  userId  String
  kind    AgreementKind
  /// The registry version that was signed, e.g. "סודיות-1.0".
  version String
  channel AgreementChannel

  signedAt   DateTime
  /// The full name as the signer typed it, not as the users table has it.
  signedName String
  ip         String?
  userAgent  String?
  /// SHA-256 hex of the exact file text that was shown.
  contentHash String
  /// The signed PDF in Drive. Null when Drive was unavailable: the
  /// signature still counts, and the PDF can be produced again from this
  /// row and the versioned text.
  driveFileId String?
  /// Who recorded an EMAIL_PDF signature. Null for APP, where the signer
  /// recorded it themselves.
  recordedById String?
  createdAt    DateTime @default(now())

  /// Restrict, not Cascade: users are soft-deleted in this product, and a
  /// hard delete that silently took the signatures with it would destroy
  /// the one record that has to outlive the employment.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind])
  @@map("employee_agreements")
}

/// What a one-time agreement link is for.
enum AgreementLinkPurpose {
  /// Sign in the app's own form, without a session.
  APP_SIGN
  /// Upload the signed PDF of the blank form (the PDF channel). Added
  /// 16.10.2026: an agent cannot take an attachment out of an email reply,
  /// so the person uploads it here and the server files it.
  PDF_UPLOAD
}

/// A one-time link to sign an agreement without a session, for someone
/// whose account is already suspended, or to upload the signed PDF.
/// Hash-only storage, exactly like PortalLoginToken: the raw token exists
/// only in the emailed link.
model AgreementSignLink {
  id          String               @id @default(cuid())
  userId      String
  kind        AgreementKind
  version     String
  purpose     AgreementLinkPurpose @default(APP_SIGN)
  tokenHash   String               @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// PDF_UPLOAD: the ClientDocument the upload was filed as.
  documentId  String?
  /// PDF_UPLOAD: when the uploaded document was dealt with, either
  /// recorded as a signature (record_pdf_signature, also when that version
  /// was already recorded) or dismissed with a reason (dismiss_pdf_upload).
  /// An upload with a document and no review is what is still waiting.
  reviewedAt   DateTime?
  reviewedById String?
  createdById String
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agreement_sign_links")
}
