{
  "name": "ankora-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && node scripts/seed-preview.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "11.3.19",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.383.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "^1.5.0",
    "server-only": "^0.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "10.4.19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.13",
    "typescript": "5.5.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
