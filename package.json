{
  "name": "ankora-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && node scripts/seed-preview.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "qa": "node qa/run.mjs",
    "qa:1": "node qa/run.mjs 1",
    "qa:2": "node qa/run.mjs 2",
    "qa:3": "node qa/run.mjs 3",
    "qa:scan": "node qa/scan.mjs",
    "qa:sync": "node qa/scan.mjs --sync"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hebcal/core": "5.9.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/client": "6.19.3",
    "@umalqura/core": "^0.0.7",
    "@vercel/oidc": "^3.8.8",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "date-easter": "^1.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "11.3.19",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.383.0",
    "lunar-javascript": "^1.7.7",
    "mcp-handler": "^2.2.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote-client": "1.1.9",
    "pdfkit": "^0.20.2",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "^1.5.0",
    "server-only": "^0.0.1",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.15",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "10.4.19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.25",
    "pdfjs-dist": "6.3.289",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.13",
    "typescript": "5.5.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "js-yaml": "^3.15.2"
  }
